---
// 和モダン・オープニングローディング画面（セクション復帰時はスムーズにスキップ）
---

<div id="loading-screen" class="loading-screen" aria-hidden="true">
  <div class="loading-content">
    <div class="loading-logo-wrap">
      <img src="/images/title_white.png" alt="庭や・笑" class="loading-logo" />
    </div>
    <div class="loading-spinner">
      <span class="spinner-circle"></span>
    </div>
    <p class="loading-text">笑顔が活きる空間に</p>
  </div>
</div>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #1a201c;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s cubic-bezier(0.65, 0, 0.35, 1), visibility 0.8s;
    pointer-events: auto;
  }

  .loading-screen.is-loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    transform: translateY(0);
    transition: transform 0.6s ease, opacity 0.6s ease;
  }

  .loading-screen.is-loaded .loading-content {
    opacity: 0;
    transform: translateY(-15px);
  }

  .loading-logo-wrap {
    width: 220px;
    max-width: 70vw;
    opacity: 0.95;
    animation: pulseLogo 2s infinite ease-in-out;
  }

  .loading-logo {
    width: 100%;
    height: auto;
    display: block;
  }

  .loading-spinner {
    position: relative;
    width: 36px;
    height: 36px;
    margin: 4px 0;
  }

  .spinner-circle {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-top-color: #7a9a80;
    animation: spin 1s infinite linear;
  }

  .loading-text {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.95rem;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    padding-left: 0.25em;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulseLogo {
    0%, 100% {
      opacity: 0.85;
      transform: scale(0.99);
    }
    50% {
      opacity: 1;
      transform: scale(1.01);
    }
  }
</style>

<script>
  function handleLoading() {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    // ハッシュ（#service, #works等）または直前の離脱セクションを判定
    const targetHash = window.location.hash || sessionStorage.getItem('niwaya_return_hash');
    const isReturningToSection = Boolean(targetHash && targetHash.length > 1);

    // 途中のセクションに戻る場合はローディング待機をスキップして即座に表示
    const minDisplayTime = isReturningToSection ? 60 : 700;
    const startTime = Date.now();

    const hideLoader = () => {
      const elapsed = Date.now() - startTime;
      const remaining = Math.max(0, minDisplayTime - elapsed);

      setTimeout(() => {
        loader.classList.add('is-loaded');
        window.dispatchEvent(new CustomEvent('page-loaded'));

        // 該当セクションへヘッダー高さを考慮して正確にスクロール移動
        if (targetHash) {
          try {
            const targetEl = document.querySelector(targetHash);
            if (targetEl) {
              sessionStorage.removeItem('niwaya_return_hash');
              setTimeout(() => {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }, 100);
            }
          } catch (e) {
            // 無効なセレクタ対策
          }
        }
      }, remaining);
    };

    if (document.readyState === 'complete') {
      hideLoader();
    } else {
      window.addEventListener('load', hideLoader);
      setTimeout(hideLoader, 2500);
    }
  }

  handleLoading();
</script>
