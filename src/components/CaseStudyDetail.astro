---
interface Props {
    title: string;
    images?: Array<{ src: string; alt: string; caption?: string }>;
    beforeAfter?: { before: { src: string; alt: string }; after: { src: string; alt: string } };
    description: string | string[];
    singleImageStyle?: 'default' | 'kadomatsu';
    prev?: { href: string; label: string };
    next?: { href: string; label: string };
}

const { title, images, beforeAfter, description, singleImageStyle = 'default', prev, next } = Astro.props;

// 説明文を配列に統一
const descriptionArray = Array.isArray(description) ? description : [description];
---

<article class="blog-post u-section case-study-detail-section">
    <div class="container u-container">
        <div class="blog-post-content fade-up">
            <!-- Before/After画像 -->
            {beforeAfter && (
                <div class="case-study-images-grid case-study-detail-images-grid">
                    <figure class="case-study-image-wrapper case-study-detail-image-wrapper">
                        <img src={beforeAfter.before.src} alt={beforeAfter.before.alt} class="case-study-detail-image" />
                        <figcaption class="case-study-detail-figcaption">施工前（Before）</figcaption>
                    </figure>
                    <figure class="case-study-image-wrapper case-study-detail-image-wrapper">
                        <img src={beforeAfter.after.src} alt={beforeAfter.after.alt} class="case-study-detail-image" />
                        <figcaption class="case-study-detail-figcaption">施工後（After）</figcaption>
                    </figure>
                </div>
            )}

            <!-- 単一画像（先にチェック） -->
            {images && images.length === 1 && !beforeAfter && singleImageStyle === 'default' && (
                <div class="blog-post-image case-study-detail-single-image">
                    <img src={images[0].src} alt={images[0].alt} />
                </div>
            )}
            {images && images.length === 1 && !beforeAfter && singleImageStyle === 'kadomatsu' && (
                <div class="case-study-image-wrapper case-study-detail-kadomatsu-image">
                    <img src={images[0].src} alt={images[0].alt} />
                </div>
            )}

            <!-- 画像グリッド（Before/After以外、2枚以上の場合のみ） -->
            {images && images.length > 1 && !beforeAfter && (
                <div class="case-study-images-grid case-study-detail-images-grid">
                    {images.map((image) => (
                        <figure class="case-study-image-wrapper case-study-detail-image-wrapper">
                            <img src={image.src} alt={image.alt} class="case-study-detail-image" />
                            {image.caption && (
                                <figcaption class="case-study-detail-figcaption">{image.caption}</figcaption>
                            )}
                        </figure>
                    ))}
                </div>
            )}

            <!-- 説明文 -->
            <div class="blog-post-text case-study-detail-text-wrapper">
                {descriptionArray.map((para) => (
                    <p class="case-study-detail-text">
                        {para}
                    </p>
                ))}
            </div>
        </div>

        <!-- 戻るボタン（トップに戻る＆一覧に戻るの2本立て） -->
        <div class="detail-actions-box fade-up">
            <a href="/" class="u-btn">&larr; トップページに戻る</a>
            <a href="/case-study" class="u-btn u-btn--outline">施工例一覧に戻る</a>
        </div>

        <nav class="post-navigation case-study-detail-nav fade-up" aria-label="投稿ナビゲーション">
            {prev ? (
                <a class="post-nav-link prev case-study-detail-nav-link" href={prev.href}>
                    <span class="nav-label case-study-detail-nav-label">← 前の事例</span>
                    <span class="nav-title case-study-detail-nav-title">{prev.label}</span>
                </a>
            ) : (
                <div class="case-study-detail-nav-spacer"></div>
            )}
            {next && (
                <a class="post-nav-link next case-study-detail-nav-link" href={next.href}>
                    <span class="nav-label case-study-detail-nav-label">次の事例 →</span>
                    <span class="nav-title case-study-detail-nav-title">{next.label}</span>
                </a>
            )}
        </nav>
    </div>
</article>

<style>
  .detail-actions-box {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 40px 0;
    flex-wrap: wrap;
  }
</style>
