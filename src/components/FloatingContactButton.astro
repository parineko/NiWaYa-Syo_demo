---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
---

<!-- 右下固定の洗練された楕円形（ピル型）フローティングボタン -->
<div class="floating-cta-wrap" id="floating-cta">
  <a href="#contact" class="floating-cta-btn" aria-label="無料相談・お見積もりへ">
    <div class="cta-pulse-ring"></div>
    <div class="cta-icon-box">
      <svg class="cta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    </div>
    <div class="cta-text-box">
      <span class="cta-mini-label">現地調査・お見積り無料</span>
      <span class="cta-main-text">無料相談・お見積り</span>
    </div>
  </a>
</div>

<style>
  .floating-cta-wrap {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 1000;
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  /* 表示状態（スクロール開始後） */
  .floating-cta-wrap.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* お問い合わせセクションに入ったらスッと消える */
  .floating-cta-wrap.is-hidden {
    opacity: 0 !important;
    transform: translateY(20px) scale(0.95) !important;
    visibility: hidden !important;
    pointer-events: none;
  }

  .floating-cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, #4a5d4e 0%, #364639 100%);
    color: #ffffff;
    padding: 12px 24px 12px 18px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(43, 51, 45, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .floating-cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(43, 51, 45, 0.45);
  }

  .cta-icon-box {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cta-svg {
    width: 20px;
    height: 20px;
    stroke: #ffffff;
  }

  .cta-text-box {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.25;
  }

  .cta-mini-label {
    font-size: 0.68rem;
    color: #c5dfc9;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .cta-main-text {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: 'Noto Serif JP', serif;
  }

  /* 呼吸のような微細パルスリング */
  .cta-pulse-ring {
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid rgba(74, 93, 78, 0.6);
    animation: ctaPulse 2.4s infinite ease-out;
    pointer-events: none;
  }

  @keyframes ctaPulse {
    0% {
      transform: scale(0.98);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.04);
      opacity: 0;
    }
    100% {
      transform: scale(0.98);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .floating-cta-wrap {
      bottom: 20px;
      right: 16px;
    }

    .floating-cta-btn {
      padding: 10px 18px 10px 14px;
    }

    .cta-icon-box {
      width: 34px;
      height: 34px;
    }

    .cta-svg {
      width: 18px;
      height: 18px;
    }

    .cta-mini-label {
      font-size: 0.62rem;
    }

    .cta-main-text {
      font-size: 0.88rem;
    }
  }
</style>

<script>
  function initFloatingCTA() {
    const cta = document.getElementById('floating-cta');
    const contactSection = document.getElementById('contact');
    if (!cta) return;

    // スクロール検知：ファーストビューを過ぎたら表示、コンタクトに入ったら消す
    const handleScroll = () => {
      const scrollY = window.scrollY;

      // 1. スクロールが100px以上進んだらふわっと表示
      if (scrollY > 150) {
        cta.classList.add('is-visible');
      } else {
        cta.classList.remove('is-visible');
      }

      // 2. お問い合わせセクション（#contact）が見えたら消す
      if (contactSection) {
        const contactRect = contactSection.getBoundingClientRect();
        // コンタクトセクションの上端が画面内に入ってきたら非表示
        if (contactRect.top < window.innerHeight - 80 && contactRect.bottom > 0) {
          cta.classList.add('is-hidden');
        } else {
          cta.classList.remove('is-hidden');
        }
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingCTA);
  } else {
    initFloatingCTA();
  }
</script>
