---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
---

<!-- フローティングお問い合わせ（PC: 右下フロート / スマホ: 画面下部固定コンバージョンバー） -->
<div class="conversion-dock" id="conversion-dock">
  <!-- スマホ用固定バー -->
  <div class="dock-mobile-bar">
    <a href="tel:0925150747" class="dock-btn dock-btn--tel" aria-label="お電話で無料相談">
      <svg class="dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span class="dock-text">
        <span class="dock-label">通話無料</span>
        <strong>電話で相談</strong>
      </span>
    </a>
    <a href="#contact" class="dock-btn dock-btn--form" aria-label="WEB無料見積もりへ">
      <svg class="dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
      <span class="dock-text">
        <span class="dock-label">24時間受付</span>
        <strong>無料お見積もり</strong>
      </span>
    </a>
  </div>

  <!-- PC用フローティングボタン -->
  <div class="dock-pc-button">
    <a href="#contact" class="pc-float-btn" aria-label="無料お見積もり・お問い合わせ">
      <svg class="pc-float-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="pc-float-text">無料相談・お見積もり</span>
    </a>
  </div>
</div>

<style>
  .conversion-dock {
    position: fixed;
    z-index: 1000;
  }

  /* PC表示 */
  @media (min-width: 769px) {
    .dock-mobile-bar {
      display: none;
    }

    .dock-pc-button {
      position: fixed;
      bottom: 30px;
      right: 30px;
    }

    .pc-float-btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: #4a5d4e;
      color: #ffffff;
      padding: 16px 28px;
      border-radius: 999px;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      font-family: 'Noto Serif JP', serif;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    }

    .pc-float-btn:hover {
      transform: translateY(-3px);
      background: #37463a;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    }

    .pc-float-icon {
      width: 20px;
      height: 20px;
    }
  }

  /* スマホ表示（画面下部にぴったり吸着） */
  @media (max-width: 768px) {
    .dock-pc-button {
      display: none;
    }

    .conversion-dock {
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
    }

    .dock-mobile-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.15);
      background: #ffffff;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .dock-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 10px;
      text-decoration: none;
      color: #ffffff;
      transition: opacity 0.2s;
    }

    .dock-btn:active {
      opacity: 0.85;
    }

    .dock-btn--tel {
      background: #2e7d32; /* 電話は視認性の高いグリーン */
      border-right: 1px solid rgba(255, 255, 255, 0.2);
    }

    .dock-btn--form {
      background: #4a5d4e; /* 和の深緑 */
    }

    .dock-icon {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    .dock-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .dock-label {
      font-size: 0.65rem;
      opacity: 0.85;
      letter-spacing: 0.05em;
    }

    .dock-text strong {
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
  }
</style>
