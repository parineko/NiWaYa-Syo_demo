---
// 施工例画像の配列（3枚のみ）
const workImages = [
  {
    src: '/images/竹垣施工.jpg',
    alt: '竹垣施工',
    title: '竹垣施工',
    link: '/bamboo-fence'
  },
  {
    src: '/images/店舗_坪庭_アプローチ2.jpg',
    alt: 'アプローチ',
    title: 'アプローチ',
    link: '/garden-tile'
  },
  {
    src: '/images/oniwasenteigo-01s02.jpg',
    alt: '施工例',
    title: '施工例',
    link: '/case-stady'
  }
];
---

<div class="work-slider-wrapper">
  <div class="swiper work-swiper">
    <div class="swiper-wrapper">
      {workImages.map((image) => (
        <div class="swiper-slide">
          <div class="work-slide">
            <a href={image.link} class="work-slide-link">
              <img src={image.src} alt={image.alt} class="work-slide-image" />
              <div class="work-slide-overlay">
                <h3 class="work-slide-title">{image.title}</h3>
              </div>
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .work-slider-wrapper {
    position: relative;
    width: 100%;
    padding: 0 20px;
  }

  .work-swiper {
    width: 100%;
    padding-bottom: 50px;
  }

  .work-slide {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
    border-radius: 8px;
  }

  .work-slide-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .work-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .work-slide-link:hover .work-slide-image {
    transform: scale(1.05);
  }

  .work-slide-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    padding: 30px;
    color: #ffffff;
  }

  .work-slide-title {
    font-size: 24px;
    font-weight: 600;
    font-family: 'Noto Serif JP', serif;
    color: #ffffff;
    margin: 0;
  }

  .swiper-pagination {
    bottom: 10px !important;
  }

  .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: #666666;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
    background: #666666;
  }

  @media (max-width: 768px) {
    .work-slide {
      height: 400px;
    }

    .work-slide-title {
      font-size: 20px;
    }
  }
</style>

<script>
  import initWorkSlider from '../scripts/initWorkSlider';
  
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWorkSlider);
    } else {
      initWorkSlider();
    }
  }
</script>

