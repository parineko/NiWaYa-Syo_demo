---
// ヒーロー画像の配列（後で差し替え可能）
const heroImages = [
  {
    src: '/images/sekourei_02.jpg',
    alt: '施工例',
    title: '庭や・笑',
    subtitle: '笑顔が活きる空間に'
  },
  {
    src: '/images/fukuoka_zouen_r101.jpg',
    alt: '福岡造園',
    title: '職人の技',
    subtitle: '伝統とモダンの融合'
  },
  {
    src: '/images/竹垣施工.jpg',
    alt: '竹垣施工',
    title: '理想の庭造り',
    subtitle: 'お客様の想いを形に'
  }
];
---

<div class="hero-slider-wrapper">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {heroImages.map((image) => (
        <div class="swiper-slide">
          <div class="hero-slide">
            <img src={image.src} alt={image.alt} class="hero-slide-image" />
            <div class="hero-slide-content">
              <h1 class="hero-title" data-title={image.title}>{image.title}</h1>
              <p class="hero-subtitle" data-subtitle={image.subtitle}>{image.subtitle}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .hero-slider-wrapper {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 500px;
    overflow: hidden;
  }

  .hero-swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-slide-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    color: #ffffff;
  }

  .hero-title {
    font-size: 48px;
    font-weight: 600;
    font-family: 'Shippori Mincho', serif !important;
    margin-bottom: 15px;
    text-shadow: 
      0 0 10px rgba(0, 0, 0, 0.8),
      0 0 20px rgba(0, 0, 0, 0.6),
      0 2px 4px rgba(0, 0, 0, 0.9),
      0 4px 8px rgba(0, 0, 0, 0.7),
      2px 2px 4px rgba(0, 0, 0, 0.8),
      -2px -2px 4px rgba(0, 0, 0, 0.8);
    color: #ffffff;
  }

  .hero-title .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(10px);
  }
  
  .hero-title.animate .char {
    animation: fadeInChar 0.6s ease forwards;
  }

  .hero-subtitle {
    font-size: 24px;
    font-weight: 400;
    font-family: 'Noto Serif JP', serif !important;
    text-shadow: 
      0 0 8px rgba(0, 0, 0, 0.8),
      0 0 16px rgba(0, 0, 0, 0.6),
      0 2px 3px rgba(0, 0, 0, 0.9),
      0 3px 6px rgba(0, 0, 0, 0.7),
      1px 1px 3px rgba(0, 0, 0, 0.8),
      -1px -1px 3px rgba(0, 0, 0, 0.8);
    color: #ffffff;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.8s ease 0.8s, transform 0.8s ease 0.8s;
  }

  .hero-subtitle.fade-in {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  @keyframes fadeInChar {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .swiper-pagination {
    bottom: 30px !important;
  }

  .swiper-pagination-bullet {
    width: 12px;
    height: 12px;
    background: #ffffff;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
    background: #ffffff;
  }

  @media (max-width: 768px) {
    .hero-slider-wrapper {
      height: 50vh;
      min-height: 400px;
    }

    .hero-title {
      font-size: 32px;
      text-shadow: 
        0 0 8px rgba(0, 0, 0, 0.8),
        0 0 16px rgba(0, 0, 0, 0.6),
        0 2px 3px rgba(0, 0, 0, 0.9),
        0 3px 6px rgba(0, 0, 0, 0.7),
        1px 1px 3px rgba(0, 0, 0, 0.8),
        -1px -1px 3px rgba(0, 0, 0, 0.8);
    }

    .hero-subtitle {
      font-size: 18px;
      text-shadow: 
        0 0 6px rgba(0, 0, 0, 0.8),
        0 0 12px rgba(0, 0, 0, 0.6),
        0 1px 2px rgba(0, 0, 0, 0.9),
        0 2px 4px rgba(0, 0, 0, 0.7),
        1px 1px 2px rgba(0, 0, 0, 0.8),
        -1px -1px 2px rgba(0, 0, 0, 0.8);
    }
  }
</style>

<script>
  import initHeroSlider from '../scripts/initHeroSlider';
  
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }
  }
</script>

