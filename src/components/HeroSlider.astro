---
// ヒーロー画像の配列
const heroImages = [
  {
    src: '/images/sekourei_02.jpg',
    alt: '庭や・笑の施工事例',
    tag: 'GARDEN & SMILE',
    title: '笑顔が活きる空間に',
    subtitle: '福岡・粕屋の造園・庭木剪定・エクステリア'
  },
  {
    src: '/images/fukuoka_zouen_r101.jpg',
    alt: '伝統とモダンが調和する庭園',
    tag: 'TRADITIONAL & MODERN',
    title: '職人の技と心で整える',
    subtitle: '四季の移ろいを愉しむ、心安らぐ庭づくり'
  },
  {
    src: '/images/takegaki_sekou.jpg',
    alt: '伝統と美が息づく竹垣施工',
    tag: 'CUSTOM DESIGN',
    title: '想いを、丁寧にかたちに',
    subtitle: '一本の剪定から、理想のお庭プロデュースまで'
  }
];
---

<div class="hero-slider-wrapper" id="hero-slider">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {heroImages.map((image, index) => (
        <div class="swiper-slide">
          <div class={`hero-slide ${index === 0 ? 'is-first-slide' : ''}`}>
            <!-- 背景画像（Ken Burnsアニメーション） -->
            <div class="hero-image-wrap">
              <img
                src={image.src}
                alt={image.alt}
                class="hero-slide-image"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </div>

            <!-- 暗転グラデーションオーバーレイ -->
            <div class="hero-overlay"></div>

            <!-- コンテンツ（文字フェードイン） -->
            <div class="hero-slide-content">
              <span class="hero-slide-tag">{image.tag}</span>
              <h1 class="hero-title">{image.title}</h1>
              <div class="hero-divider"></div>
              <p class="hero-subtitle">{image.subtitle}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <!-- スクロール誘導インジケーター（SCROLL ↓） -->
  <a href="#concept" class="hero-scroll-indicator" aria-label="コンテンツへスクロール">
    <span class="scroll-text">SCROLL</span>
    <span class="scroll-line"></span>
  </a>
</div>

<style>
  /* 画面いっぱいに広がる100dvhフルスクリーン設計 */
  .hero-slider-wrapper {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 600px;
    overflow: hidden;
    background-color: #1a201c;
  }

  .hero-swiper {
    width: 100%;
    height: 100%;
  }

  /* Swiper初期化前のチラつき防止（1枚目以外を即座に非表示） */
  .hero-swiper:not(.swiper-initialized) .swiper-slide:not(:first-child) {
    display: none;
  }

  .swiper-slide {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-slide {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.0);
    transition: transform 6s ease-out;
  }

  /* Swiperのアクティブスライドでゆっくりズームする上質演出 */
  :global(.swiper-slide-active) .hero-slide-image {
    transform: scale(1.08);
  }

  /* ---------------------------------------
     1枚目のストーリー仕立てオープニング演出
     ① 画像フェードイン → ② 暗転 → ③ 文字フェードイン
  --------------------------------------- */
  /* 初期待機状態（ローディング中） */
  .hero-slider-wrapper:not(.is-ready) .is-first-slide .hero-slide-image {
    opacity: 0;
    transform: scale(1.12);
  }

  .hero-slider-wrapper:not(.is-ready) .is-first-slide .hero-overlay {
    opacity: 0.2;
  }

  .hero-slider-wrapper:not(.is-ready) .is-first-slide .hero-slide-content {
    opacity: 0;
    transform: translate(-50%, -40%);
  }

  .hero-slider-wrapper:not(.is-ready) .hero-scroll-indicator {
    opacity: 0;
    transform: translateY(10px);
  }

  /* ① 画像フェードイン (0s - 1.2s) */
  .hero-slider-wrapper.is-ready .is-first-slide .hero-slide-image {
    opacity: 1;
    transform: scale(1.0);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 5s ease-out;
  }

  /* ② 暗転オーバーレイが深まる (0.5s - 1.6s) */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(20, 26, 22, 0.45) 0%,
      rgba(15, 20, 17, 0.75) 100%
    );
    z-index: 1;
    transition: opacity 1.2s ease 0.4s;
  }

  .hero-slider-wrapper.is-ready .is-first-slide .hero-overlay {
    opacity: 1;
  }

  /* ③ 文字コンテンツがフェードイン (0.9s - 2.0s) */
  .hero-slide-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    color: #ffffff;
    width: 90%;
    max-width: 900px;
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.8s, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.8s;
  }

  .hero-slider-wrapper.is-ready .is-first-slide .hero-slide-content {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .hero-slide-tag {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: #b0cbb3;
    margin-bottom: 16px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .hero-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 700;
    font-family: 'Shippori Mincho', serif !important;
    letter-spacing: 0.12em;
    line-height: 1.25;
    margin: 0 0 20px 0;
    text-shadow:
      0 2px 12px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(0, 0, 0, 0.5);
    color: #ffffff;
  }

  .hero-divider {
    width: 60px;
    height: 2px;
    background: #a8d5af;
    margin: 0 auto 24px;
    border-radius: 2px;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.5vw, 1.5rem);
    font-weight: 500;
    font-family: 'Noto Serif JP', serif !important;
    letter-spacing: 0.08em;
    line-height: 1.6;
    margin: 0;
    color: #f5f8f5;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  /* ---------------------------------------
     スクロール誘導インジケーター（SCROLL ↓）
  --------------------------------------- */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #ffffff;
    cursor: pointer;
    transition: opacity 0.8s ease 1.6s, transform 0.8s ease 1.6s;
  }

  .hero-slider-wrapper.is-ready .hero-scroll-indicator {
    opacity: 0.9;
    transform: translateX(-50%) translateY(0);
  }

  .hero-scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: 'Noto Serif JP', serif;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    font-weight: 600;
    text-indent: 0.3em;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff;
    animation: scrollAnimation 2s infinite cubic-bezier(0.65, 0, 0.35, 1);
  }

  @keyframes scrollAnimation {
    0% {
      top: -100%;
    }
    50% {
      top: 0%;
    }
    100% {
      top: 100%;
    }
  }

  /* ページネーション */
  .swiper-pagination {
    bottom: 30px !important;
    right: 40px !important;
    left: auto !important;
    width: auto !important;
    z-index: 10;
  }

  :global(.hero-swiper .swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    background: #ffffff !important;
    opacity: 0.4;
    transition: all 0.3s ease;
    margin: 0 6px !important;
  }

  :global(.hero-swiper .swiper-pagination-bullet-active) {
    opacity: 1;
    width: 28px;
    border-radius: 5px;
    background: #a8d5af !important;
  }

  @media (max-width: 768px) {
    .hero-title {
      letter-spacing: 0.08em;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .swiper-pagination {
      display: none; /* スマホではスクロールインジケーターに集中 */
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination, EffectFade } from 'swiper/modules';

  function initHero() {
    const wrapper = document.getElementById('hero-slider');
    if (!wrapper) return;

    // ローディング完了イベント受信、または直接アクティブ化
    const triggerAnimation = () => {
      wrapper.classList.add('is-ready');
    };

    window.addEventListener('page-loaded', triggerAnimation);
    // フォールバック（万が一イベントが発火しなかった場合）
    setTimeout(triggerAnimation, 900);

    // Swiperの初期化（オープニングアニメーションが終わった後にゆったり自動再生開始）
    const swiperEl = document.querySelector('.hero-swiper');
    if (swiperEl && !(swiperEl as any).swiper) {
      new Swiper('.hero-swiper', {
        modules: [Autoplay, Pagination, EffectFade],
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        autoplay: {
          delay: 6000,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.hero-swiper .swiper-pagination',
          clickable: true,
        },
        loop: true,
        speed: 1500,
      });
    }

    // スクロールボタンのスムーススクロール
    const scrollBtn = wrapper.querySelector('.hero-scroll-indicator');
    if (scrollBtn) {
      scrollBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('concept');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
