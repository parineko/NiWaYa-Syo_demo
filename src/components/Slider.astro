---
interface SliderItem {
    src: string;
    alt: string;
    title?: string;
    subtitle?: string;
    link?: string;
}

interface Props {
    type: 'hero' | 'case-study';
    items: SliderItem[];
    config?: {
        autoplayDelay?: number;
        speed?: number;
        effect?: 'fade' | 'slide';
    };
}

const { type, items, config = {} } = Astro.props;

const defaultConfig = {
    hero: {
        autoplayDelay: 4000,
        speed: 1000,
        effect: 'fade' as const
    },
    'case-study': {
        autoplayDelay: 5000,
        speed: 600,
        effect: 'slide' as const
    }
};

const sliderConfig = {
    autoplayDelay: config.autoplayDelay ?? defaultConfig[type].autoplayDelay,
    speed: config.speed ?? defaultConfig[type].speed,
    effect: config.effect ?? defaultConfig[type].effect
};

const sliderClass = type === 'hero' ? 'hero-swiper' : 'case-study-swiper';
const wrapperClass = type === 'hero' ? 'hero-slider-wrapper' : 'case-study-slider-wrapper';
const slideClass = type === 'hero' ? 'hero-slide' : 'case-study-slide';
const imageClass = type === 'hero' ? 'hero-slide-image' : 'case-study-slide-image';
const contentClass = type === 'hero' ? 'hero-slide-content' : 'case-study-slide-content';
const titleClass = type === 'hero' ? 'hero-title' : 'case-study-slide-title';
const subtitleClass = type === 'hero' ? 'hero-subtitle' : '';
---

<div class={wrapperClass}>
    <div class={`swiper ${sliderClass}`}>
        <div class="swiper-wrapper">
            {items.map((item) => (
                <div class="swiper-slide">
                    <div class={slideClass}>
                        <img src={item.src} alt={item.alt} class={imageClass} />
                        {type === 'hero' && item.title && (
                            <div class={contentClass}>
                                <h1 class={titleClass}>{item.title}</h1>
                                {item.subtitle && <p class={subtitleClass}>{item.subtitle}</p>}
                            </div>
                        )}
                        {type === 'case-study' && (
                            <div class={contentClass}>
                                {item.title && <h3 class={titleClass}>{item.title}</h3>}
                                {item.link && (
                                    <a href={item.link} class="btn btn-primary contact-button-animated case-study-slide-button">詳しく見る</a>
                                )}
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>

{type === 'hero' && (
    <style>
        .hero-slider-wrapper {
            position: relative;
            width: 100%;
            height: 70vh;
            min-height: 500px;
            overflow: hidden;
        }

        .hero-swiper {
            width: 100%;
            height: 100%;
        }

        .swiper-slide {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .hero-slide {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .hero-slide-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .hero-slide-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 2;
            color: #ffffff;
        }

        .hero-title {
            font-size: 48px;
            font-weight: 600;
            font-family: 'Shippori Mincho', serif !important;
            margin-bottom: 15px;
            text-shadow: 
                0 0 10px rgba(0, 0, 0, 0.8),
                0 0 20px rgba(0, 0, 0, 0.6),
                0 2px 4px rgba(0, 0, 0, 0.9),
                0 4px 8px rgba(0, 0, 0, 0.7),
                2px 2px 4px rgba(0, 0, 0, 0.8),
                -2px -2px 4px rgba(0, 0, 0, 0.8);
            color: #ffffff;
        }

        .hero-subtitle {
            font-size: 24px;
            font-weight: 400;
            font-family: 'Noto Serif JP', serif !important;
            text-shadow: 
                0 0 8px rgba(0, 0, 0, 0.8),
                0 0 16px rgba(0, 0, 0, 0.6),
                0 2px 3px rgba(0, 0, 0, 0.9),
                0 3px 6px rgba(0, 0, 0, 0.7),
                1px 1px 3px rgba(0, 0, 0, 0.8),
                -1px -1px 3px rgba(0, 0, 0, 0.8);
            color: #ffffff;
        }

        .swiper-pagination {
            bottom: 30px !important;
        }

        .swiper-pagination-bullet {
            width: 12px;
            height: 12px;
            background: #ffffff;
            opacity: 0.5;
        }

        .swiper-pagination-bullet-active {
            opacity: 1;
            background: #ffffff;
        }

        @media (max-width: 768px) {
            .hero-slider-wrapper {
                height: 50vh;
                min-height: 400px;
            }

            .hero-title {
                font-size: 32px;
                text-shadow: 
                    0 0 8px rgba(0, 0, 0, 0.8),
                    0 0 16px rgba(0, 0, 0, 0.6),
                    0 2px 3px rgba(0, 0, 0, 0.9),
                    0 3px 6px rgba(0, 0, 0, 0.7),
                    1px 1px 3px rgba(0, 0, 0, 0.8),
                    -1px -1px 3px rgba(0, 0, 0, 0.8);
            }

            .hero-subtitle {
                font-size: 18px;
                text-shadow: 
                    0 0 6px rgba(0, 0, 0, 0.8),
                    0 0 12px rgba(0, 0, 0, 0.6),
                    0 1px 2px rgba(0, 0, 0, 0.9),
                    0 2px 4px rgba(0, 0, 0, 0.7),
                    1px 1px 2px rgba(0, 0, 0, 0.8),
                    -1px -1px 2px rgba(0, 0, 0, 0.8);
            }
        }
    </style>
)}

{type === 'case-study' && (
    <style>
        .case-study-slider-wrapper {
            position: relative;
            width: 100%;
            padding: 0 20px;
            margin: 0;
        }

        .case-study-swiper {
            width: 100%;
            padding-bottom: 20px;
        }

        .case-study-slide {
            position: relative;
            width: 100%;
            height: 600px;
            overflow: hidden;
            border-radius: 8px;
            background: #ffffff;
        }

        .case-study-slide-image {
            width: 100%;
            height: 80%;
            object-fit: cover;
            display: block;
        }

        .case-study-slide-content {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            padding: 30px;
            text-align: center;
        }

        .case-study-slide-title {
            font-size: 24px;
            font-weight: 600;
            font-family: 'Shippori Mincho', serif !important;
            color: #000000;
            margin: 0 0 20px 0;
        }

        .case-study-slide-button {
            display: inline-block;
        }

        .swiper-pagination {
            bottom: 10px !important;
        }

        .swiper-pagination-bullet {
            width: 10px;
            height: 10px;
            background: #666666;
            opacity: 0.5;
        }

        .swiper-pagination-bullet-active {
            opacity: 1;
            background: #666666;
        }

        @media (max-width: 768px) {
            .case-study-slide {
                height: 500px;
            }

            .case-study-slide-title {
                font-size: 20px;
            }
        }
    </style>
)}

<script define:vars={{ sliderType: type, autoplayDelay: sliderConfig.autoplayDelay, speed: sliderConfig.speed }}>
    import Swiper from 'swiper';
    import { Autoplay, Pagination, EffectFade } from 'swiper/modules';

    function initSlider() {
        if (sliderType === 'hero') {
            const heroSwiper = new Swiper('.hero-swiper', {
                modules: [Autoplay, Pagination, EffectFade],
                effect: 'fade',
                fadeEffect: {
                    crossFade: true
                },
                autoplay: {
                    delay: autoplayDelay,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                loop: true,
                speed: speed,
            });
        } else if (sliderType === 'case-study') {
            const caseStudySwiper = new Swiper('.case-study-swiper', {
                modules: [Autoplay, Pagination],
                slidesPerView: 1,
                spaceBetween: 30,
                autoplay: {
                    delay: autoplayDelay,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                breakpoints: {
                    768: {
                        slidesPerView: 2,
                    },
                    1024: {
                        slidesPerView: 3,
                    }
                },
                loop: true,
                speed: speed,
            });
        }
    }

    if (typeof window !== 'undefined') {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSlider);
        } else {
            initSlider();
        }
    }
</script>
