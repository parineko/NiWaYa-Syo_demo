---
// 施工例の配列（9件）- 需要順・ユーザー興味順に並べ替え
const caseStudies = [
  {
    id: 'garden-pruning',
    title: '庭の剪定',
    image: '/images/niwanosentei-02s02.jpg',
    link: '/garden-pruning'
  },
  {
    id: 'tree-pruning',
    title: '高木の剪定',
    image: '/images/takagisentei-02s02.jpg',
    link: '/tree-pruning'
  },
  {
    id: 'weed-sheet-gravel',
    title: '防草シート･砂利敷き工事',
    image: '/images/zouen2s02.jpg',
    link: '/weed-sheet-gravel'
  },
  {
    id: 'garden-tile',
    title: '庭のアプローチ',
    image: '/images/店舗_坪庭_アプローチ2.jpg',
    link: '/garden-tile'
  },
  {
    id: 'shop-garden',
    title: '店舗･飲食店 坪庭作り',
    image: '/images/紅葉.jpg',
    link: '/shop-garden'
  },
  {
    id: 'bamboo-fence-renovation',
    title: '竹垣のリフォーム',
    image: '/images/takegakirifomu-02s02.jpg',
    link: '/bamboo-fence-renovation'
  },
  {
    id: 'bamboo-fence',
    title: '庭園 竹垣施工',
    image: '/images/竹垣施工.jpg',
    link: '/bamboo-fence'
  },
  {
    id: 'concrete-floor',
    title: 'コンクリート土間施工',
    image: '/images/konkuritodoma-02s02.jpg',
    link: '/concrete-floor'
  },
  {
    id: 'kadomatsu',
    title: '門松･正月飾り',
    image: '/images/kadomatsu-01s03.jpg',
    link: '/kadomatsu'
  }
];
---

<div class="case-study-slider-wrapper">
  <div class="swiper case-study-swiper">
    <div class="swiper-wrapper">
      {caseStudies.map((caseStudy) => (
        <div class="swiper-slide">
          <div class="case-study-slide">
            <img src={caseStudy.image} alt={caseStudy.title} class="case-study-slide-image" />
            <div class="case-study-slide-content">
              <h3 class="case-study-slide-title">{caseStudy.title}</h3>
              <a href={caseStudy.link} class="btn btn-primary contact-button-animated case-study-slide-button">詳しく見る</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .case-study-slider-wrapper {
    position: relative;
    width: 100%;
    padding: 0 20px;
    margin: 0;
  }

  .case-study-swiper {
    width: 100%;
    padding-bottom: 20px;
  }

  .case-study-slide {
    position: relative;
    width: 100%;
    height: 600px;
    overflow: hidden;
    border-radius: 8px;
    background: #ffffff;
  }

  .case-study-slide-image {
    width: 100%;
    height: 80%;
    object-fit: cover;
    display: block;
  }

  .case-study-slide-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    padding: 30px;
    text-align: center;
  }

  .case-study-slide-title {
    font-size: 24px;
    font-weight: 600;
    font-family: 'Shippori Mincho', serif !important;
    color: #000000;
    margin: 0 0 20px 0;
  }

  .case-study-slide-button {
    display: inline-block;
  }

  .swiper-pagination {
    bottom: 10px !important;
  }

  .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: #666666;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
    background: #666666;
  }

  @media (max-width: 768px) {
    .case-study-slide {
      height: 500px;
    }

    .case-study-slide-title {
      font-size: 20px;
    }
  }
</style>

<script>
  import initCaseStudySlider from '../scripts/initCaseStudySlider';
  
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCaseStudySlider);
    } else {
      initCaseStudySlider();
    }
  }
</script>

