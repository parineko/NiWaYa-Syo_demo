---
// 施工例の配列（9件）- 隣のカードが覗くモダンなピークスライダー設計
const caseStudies = [
  {
    id: 'garden-pruning',
    title: '庭の剪定',
    category: '剪定・手入れ',
    tagline: '伸びすぎた枝葉を落とし、本来の美観と風通しを回復',
    image: '/images/niwanosentei-02s02.jpg',
    link: '/garden-pruning'
  },
  {
    id: 'tree-pruning',
    title: '高木の剪定',
    category: '高木・伐採',
    tagline: '電線や近隣に届く危険な大木も安全かつ迅速にお手入れ',
    image: '/images/takagisentei-02s02.jpg',
    link: '/tree-pruning'
  },
  {
    id: 'weed-sheet-gravel',
    title: '防草シート･砂利敷き',
    category: '雑草対策・美観',
    tagline: '面倒な草むしりから解放。高耐久シートで清潔なお庭へ',
    image: '/images/zouen2s02.jpg',
    link: '/weed-sheet-gravel'
  },
  {
    id: 'bamboo-fence-renovation',
    title: '竹垣のリフォーム',
    category: '竹垣改修',
    tagline: '朽ちた天然竹垣を高耐久な人工竹垣へ再生し長持ちに',
    image: '/images/takegakirifomu-02s02.jpg',
    link: '/bamboo-fence-renovation'
  },
  {
    id: 'garden-tile',
    title: '庭のアプローチ通路',
    category: 'アプローチ・外構',
    tagline: '毎日歩く動線を、自然石とモダンな敷石で歩きやすく',
    image: '/images/approach_02.jpg',
    link: '/garden-tile'
  },
  {
    id: 'shop-garden',
    title: '店舗･飲食店 坪庭作り',
    category: '坪庭・商業',
    tagline: 'お客様の心を癒やす情緒豊かな和モダン空間をプロデュース',
    image: '/images/momiji.jpg',
    link: '/shop-garden'
  },
  {
    id: 'bamboo-fence',
    title: '庭園 竹垣新設施工',
    category: '竹垣新設',
    tagline: 'お庭の格式とプライバシーを守る職人技の本格竹垣工事',
    image: '/images/takegaki_sekou.jpg',
    link: '/bamboo-fence'
  },
  {
    id: 'concrete-floor',
    title: 'コンクリート土間施工',
    category: '土間・駐車場',
    tagline: '雑草の生えない頑丈な駐車場・物置スペースを実現',
    image: '/images/konkuritodoma-02s02.jpg',
    link: '/concrete-floor'
  },
  {
    id: 'kadomatsu',
    title: '門松･正月飾り',
    category: '季節飾り',
    tagline: '新年の幕開けを祝う、伝統と格式ある手作り本格門松',
    image: '/images/kadomatsu-01s03.jpg',
    link: '/kadomatsu'
  }
];
---

<div class="case-study-slider-wrapper">
  <div class="swiper case-study-swiper">
    <div class="swiper-wrapper">
      {caseStudies.map((caseStudy) => (
        <div class="swiper-slide">
          <a href={caseStudy.link} class="case-study-slide">
            <div class="case-study-image-box">
              <span class="case-study-badge">{caseStudy.category}</span>
              <img src={caseStudy.image} alt={caseStudy.title} class="case-study-slide-image" loading="lazy" />
              <div class="case-study-overlay-hint">
                <span>事例を見る &rarr;</span>
              </div>
            </div>
            <div class="case-study-slide-content">
              <h3 class="case-study-slide-title">{caseStudy.title}</h3>
              <p class="case-study-slide-tagline">{caseStudy.tagline}</p>
              <div class="case-study-action">
                <span class="case-study-btn-pill">施工詳細を見る</span>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- ページネーションインジケーター -->
    <div class="swiper-pagination"></div>

    <!-- 左右ナビゲーション矢印 -->
    <div class="case-study-prev" aria-label="前の事例へ">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </div>
    <div class="case-study-next" aria-label="次の事例へ">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </div>
  </div>
</div>

<style>
  .case-study-slider-wrapper {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    padding: 10px 0;
  }

  .case-study-swiper {
    width: 100%;
    padding: 16px 0 54px 0 !important;
    overflow: visible !important;
  }

  /* Swiper初期化前の横並び */
  .case-study-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: 16px;
    overflow-x: hidden;
  }

  .case-study-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 78%;
  }

  /* ---------------------------------------
     隣のカードが覗くモダンなカードデザイン
  --------------------------------------- */
  .case-study-slide {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0, 0, 0, 0.06);
    /* 隣のカードが覗いた時に少し小さく半透明にする遊び心演出 */
    transform: scale(0.94);
    opacity: 0.68;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease, box-shadow 0.4s ease;
  }

  /* アクティブな中央カードは100%スケール＆立体的な影 */
  :global(.swiper-slide-active) .case-study-slide,
  :global(.swiper-slide-duplicate-active) .case-study-slide {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 12px 32px rgba(43, 58, 47, 0.14);
    border-color: #d1ded4;
  }

  .case-study-slide:hover {
    transform: scale(1.02) !important;
    opacity: 1 !important;
    box-shadow: 0 14px 36px rgba(43, 58, 47, 0.18) !important;
  }

  .case-study-image-box {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #eef2ef;
  }

  .case-study-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(35, 50, 38, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .case-study-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case-study-slide:hover .case-study-slide-image {
    transform: scale(1.08);
  }

  .case-study-overlay-hint {
    position: absolute;
    inset: 0;
    background: rgba(30, 44, 34, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .case-study-overlay-hint span {
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .case-study-slide:hover .case-study-overlay-hint {
    opacity: 1;
  }

  .case-study-slide-content {
    padding: 20px 18px;
    text-align: left;
    background: #ffffff;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
  }

  .case-study-slide-title {
    font-size: 1.15rem;
    font-weight: 700;
    font-family: 'Shippori Mincho', serif !important;
    color: #233427;
    margin: 0;
    line-height: 1.35;
  }

  .case-study-slide-tagline {
    font-size: 0.82rem;
    color: #667769;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case-study-action {
    margin-top: 6px;
    display: flex;
    justify-content: flex-end;
  }

  .case-study-btn-pill {
    font-size: 0.8rem;
    font-weight: 600;
    color: #3c6e47;
    padding: 6px 14px;
    border-radius: 999px;
    background: #eef6f0;
    border: 1px solid #d4e5d8;
    transition: all 0.2s ease;
  }

  .case-study-slide:hover .case-study-btn-pill {
    background: #3c6e47;
    color: #ffffff;
    border-color: #3c6e47;
  }

  /* ---------------------------------------
     ページネーション＆ナビゲーション矢印
  --------------------------------------- */
  :global(.case-study-swiper .swiper-pagination) {
    bottom: 8px !important;
  }

  :global(.case-study-swiper .swiper-pagination-bullet) {
    width: 8px;
    height: 8px;
    background: #3c6e47 !important;
    opacity: 0.25;
    transition: all 0.3s ease;
    margin: 0 4px !important;
  }

  :global(.case-study-swiper .swiper-pagination-bullet-active) {
    opacity: 1;
    width: 26px;
    border-radius: 4px;
  }

  .case-study-prev,
  .case-study-next {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    border: 1px solid #dbe6de;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: #2b3a2f;
    transition: all 0.25s ease;
  }

  .case-study-prev {
    left: 8px;
  }

  .case-study-next {
    right: 8px;
  }

  .case-study-prev:hover,
  .case-study-next:hover {
    background: #3c6e47;
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(60, 110, 71, 0.35);
  }

  .case-study-prev svg,
  .case-study-next svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .case-study-prev,
    .case-study-next {
      display: none; /* スマホはスワイプ操作が直感的なため非表示 */
    }
    .case-study-image-box {
      height: 190px;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination, Navigation } from 'swiper/modules';

  function initCaseStudySlider() {
    const swiperEl = document.querySelector('.case-study-swiper');
    if (!swiperEl || (swiperEl as any).swiper) return;

    new Swiper('.case-study-swiper', {
      modules: [Autoplay, Pagination, Navigation],
      // スマホで左右のカードがチラ見えする「ピークスライダー」設計
      slidesPerView: 1.22,
      centeredSlides: true,
      spaceBetween: 16,
      loop: true,
      speed: 650,
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: '.case-study-swiper .swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.case-study-next',
        prevEl: '.case-study-prev',
      },
      breakpoints: {
        480: {
          slidesPerView: 1.35,
          spaceBetween: 18,
          centeredSlides: true,
        },
        768: {
          slidesPerView: 2.3,
          spaceBetween: 22,
          centeredSlides: false,
        },
        1024: {
          slidesPerView: 3.2,
          spaceBetween: 28,
          centeredSlides: false,
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseStudySlider);
  } else {
    initCaseStudySlider();
  }
</script>
