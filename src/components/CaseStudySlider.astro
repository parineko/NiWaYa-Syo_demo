---
// 施工例の配列（9件）- 需要順・ユーザー興味順に並べ替え
const caseStudies = [
  {
    id: 'garden-pruning',
    title: '庭の剪定',
    image: '/images/niwanosentei-02s02.jpg',
    link: '/garden-pruning'
  },
  {
    id: 'tree-pruning',
    title: '高木の剪定',
    image: '/images/takagisentei-02s02.jpg',
    link: '/tree-pruning'
  },
  {
    id: 'weed-sheet-gravel',
    title: '防草シート･砂利敷き工事',
    image: '/images/zouen2s02.jpg',
    link: '/weed-sheet-gravel'
  },
  {
    id: 'garden-tile',
    title: '庭のアプローチ',
    image: '/images/approach_02.jpg',
    link: '/garden-tile'
  },
  {
    id: 'shop-garden',
    title: '店舗･飲食店 坪庭作り',
    image: '/images/momiji.jpg',
    link: '/shop-garden'
  },
  {
    id: 'bamboo-fence-renovation',
    title: '竹垣のリフォーム',
    image: '/images/takegakirifomu-02s02.jpg',
    link: '/bamboo-fence-renovation'
  },
  {
    id: 'bamboo-fence',
    title: '庭園 竹垣施工',
    image: '/images/takegaki_sekou.jpg',
    link: '/bamboo-fence'
  },
  {
    id: 'concrete-floor',
    title: 'コンクリート土間施工',
    image: '/images/konkuritodoma-02s02.jpg',
    link: '/concrete-floor'
  },
  {
    id: 'kadomatsu',
    title: '門松･正月飾り',
    image: '/images/kadomatsu-01s03.jpg',
    link: '/kadomatsu'
  }
];
---

<div class="case-study-slider-wrapper">
  <div class="swiper case-study-swiper">
    <div class="swiper-wrapper">
      {caseStudies.map((caseStudy) => (
        <div class="swiper-slide">
          <div class="case-study-slide">
            <div class="case-study-image-box">
              <img src={caseStudy.image} alt={caseStudy.title} class="case-study-slide-image" loading="lazy" />
            </div>
            <div class="case-study-slide-content">
              <h3 class="case-study-slide-title">{caseStudy.title}</h3>
              <a href={caseStudy.link} class="u-btn u-btn--outline case-study-slide-button">詳しく見る</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .case-study-slider-wrapper {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .case-study-swiper {
    width: 100%;
    padding-bottom: 40px !important;
  }

  .case-study-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: 24px;
    overflow-x: hidden;
  }

  .case-study-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 32%;
    min-width: 280px;
  }

  .case-study-slide {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .case-study-slide:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .case-study-image-box {
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  .case-study-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .case-study-slide:hover .case-study-slide-image {
    transform: scale(1.05);
  }

  .case-study-slide-content {
    padding: 24px 20px;
    text-align: center;
    background: #ffffff;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .case-study-slide-title {
    font-size: 1.15rem;
    font-weight: 600;
    font-family: 'Shippori Mincho', serif !important;
    color: #2b332d;
    margin: 0;
  }

  .case-study-slide-button {
    font-size: 0.9rem;
    padding: 8px 24px;
    min-height: 38px;
  }

  :global(.case-study-swiper .swiper-pagination) {
    bottom: 0 !important;
  }

  :global(.case-study-swiper .swiper-pagination-bullet) {
    width: 8px;
    height: 8px;
    background: #4a5d4e !important;
    opacity: 0.3;
    transition: all 0.3s ease;
  }

  :global(.case-study-swiper .swiper-pagination-bullet-active) {
    opacity: 1;
    width: 24px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .case-study-image-box {
      height: 200px;
    }
    .case-study-slide-content {
      padding: 18px 14px;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination } from 'swiper/modules';

  function initCaseStudySlider() {
    const swiperEl = document.querySelector('.case-study-swiper');
    if (!swiperEl || (swiperEl as any).swiper) return;

    new Swiper('.case-study-swiper', {
      modules: [Autoplay, Pagination],
      slidesPerView: 1,
      spaceBetween: 24,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.case-study-swiper .swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 28,
        }
      },
      loop: true,
      speed: 600,
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseStudySlider);
  } else {
    initCaseStudySlider();
  }
</script>
