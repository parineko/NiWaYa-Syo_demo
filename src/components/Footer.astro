---
<footer class="site-footer">
    <div class="container u-container footer-container">
        <div class="footer-links">
            <button type="button" class="footer-privacy-btn" data-open-privacy>プライバシーポリシー</button>
        </div>
        <p class="copyright">©︎ 2025　 庭や笑 　All rights Reserved.</p>
    </div>
</footer>

<!-- スクロールトップボタン -->
<div id="scroll-top" class="scroll-top" aria-label="上部へスクロール">
    <svg class="scroll-top-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 16" width="26" height="16">
        <path d="M13 0 L26 16 L22 16 L13 6 L4 16 L0 16 Z" fill="currentColor"/>
    </svg>
</div>

<style>
  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 24px 16px;
  }
  .footer-links {
    margin-bottom: 2px;
  }
  .footer-privacy-btn {
    background: transparent;
    border: none;
    color: #8b998e;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 4px 8px;
  }
  .footer-privacy-btn:hover {
    color: #d1ded4;
  }
</style>
