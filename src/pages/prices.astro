---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="料金 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="prices">
    <PageHeader title="料金" subtitle="まずはお気軽にご相談ください。剪定は一本からでも対応します。" />

    <section class="prices-section u-section prices-page-section">
        <div class="container u-container">
            <div class="prices-content">
                <div class="price-categories">
                    <div class="price-category">
                        <h3 class="price-category-title">剪定</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>低木1m未満</td>
                                        <td>¥700</td>
                                    </tr>
                                    <tr>
                                        <td>中低木 1m~2m未満</td>
                                        <td>￥1,500</td>
                                    </tr>
                                    <tr>
                                        <td>中木 2m~3m未満</td>
                                        <td>￥2,500</td>
                                    </tr>
                                    <tr>
                                        <td>高木 3m~5m未満</td>
                                        <td>￥5,000</td>
                                    </tr>
                                    <tr>
                                        <td>特別高木 5m~</td>
                                        <td>￥10,000～</td>
                                    </tr>
                                    <tr>
                                        <td>ゴミ処理（軽トラック一台）</td>
                                        <td>¥6,000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">伐採</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>低木1m未満</td>
                                        <td>¥1,000</td>
                                    </tr>
                                    <tr>
                                        <td>中低木 1m~2m未満</td>
                                        <td>￥2,000</td>
                                    </tr>
                                    <tr>
                                        <td>中木 2m~3m未満</td>
                                        <td>￥3,000～</td>
                                    </tr>
                                    <tr>
                                        <td>高木 3m~5m未満</td>
                                        <td>￥10,000～¥20,000</td>
                                    </tr>
                                    <tr>
                                        <td>特別高木 5m~</td>
                                        <td>￥20,000～</td>
                                    </tr>
                                    <tr>
                                        <td>ゴミ処理（軽トラック一台）</td>
                                        <td>¥6,000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">消毒・除草・防草工事</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>消毒</td>
                                        <td>￥3,000～</td>
                                    </tr>
                                    <tr>
                                        <td>除草剤</td>
                                        <td>￥1,500～</td>
                                    </tr>
                                    <tr>
                                        <td>防草シート（平方メートル当たり）</td>
                                        <td>￥800～</td>
                                    </tr>
                                    <tr>
                                        <td>草刈（平方メートル当たり）</td>
                                        <td>￥200～</td>
                                    </tr>
                                    <tr>
                                        <td>芝刈（平方メートル当たり）</td>
                                        <td>￥250～</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">庭工事</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>砂利工事（平方メートル当たり）</td>
                                        <td>￥1,800～</td>
                                    </tr>
                                    <tr>
                                        <td>芝はり工事（平方メートル当たり）</td>
                                        <td>￥2,700～</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="price-note">
                    <p>
                        ※ 料金は作業内容やお庭の状態により異なります。<br />
                        ※ お見積もりは無料です。お気軽にご相談ください。<br />
                        ※ 詳細な料金については、お問い合わせフォームまたはお電話でお問い合わせください。
                    </p>
                </div>

                <div class="page-bottom-actions">
                    <a href="/" class="u-btn">&larr; トップページに戻る</a>
                    <a href="/#contact" class="u-btn u-btn--outline">無料相談・お見積もりはこちら</a>
                </div>
            </div>
        </div>
    </section>

    <FloatingContactButton currentPage="prices" />
</BaseLayout>

<style>
  .page-bottom-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 48px;
    flex-wrap: wrap;
  }
</style>
