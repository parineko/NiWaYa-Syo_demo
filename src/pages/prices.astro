---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="料金 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="prices">
    <div class="page-header u-section u-section--tight">
        <div class="container u-container">
            <h1 class="page-title">お庭の事なら何でもお任せ下さい！</h1>
        </div>
    </div>

    <!-- トップ画像セクション -->
    <section class="prices-top-images u-section">
        <div class="container u-container">
            <div class="prices-images-grid">
                <div class="prices-image-item">
                    <a href="/images/niwakouji-02s02.jpg" class="prices-image-link">
                        <img src="/images/niwakouji-02s02.jpg" alt="niwakouji-02s02" />
                    </a>
                </div>
                <div class="prices-image-item">
                    <a href="/images/niwanosentei-02s02.jpg" class="prices-image-link">
                        <img src="/images/niwanosentei-02s02.jpg" alt="庭の剪定" />
                    </a>
                </div>
                <div class="prices-image-item">
                    <a href="/images/senteiryoukin-02s02.jpg" class="prices-image-link">
                        <img src="/images/senteiryoukin-02s02.jpg" alt="senteiryoukin-02s02" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="prices-section u-section u-section--alt">
        <div class="container u-container">
            <div class="prices-content">
                <h2 class="section-title fade-up" style="font-size: 1.8rem;">業務内容<br />剪定・伐採・草刈・防草対策<br />庭造り・リフォーム・フェンス・外構工事<br />竹垣・門松</h2>
                <div class="divider fade-up"></div>
                
                <div class="price-info">
                    <p class="price-intro">
                        <span style="color: #000000;">時代と共に変わっていく庭の形、それぞれの生活スタイルや価値観によって違う庭の形。私たちは屋外に大小関係なく楽しんだり和んだりできる空間作り、人々が健やかに生きていけるように少しでも力になれればと思っております。</span>
                    </p>
                    <p class="price-intro" style="text-align: left;">
                        <span style="color: #000000;">・1本から承っております。剪定は一部だけでも対応いたします。</span>
                    </p>
                    <p class="price-intro" style="text-align: left;">
                        <span style="color: #000000;">・お客様の要望、植物の生態、花の時期、主屋と庭とのバランスを考えながら、ご相談させていただき、お庭の管理・施工をいたします。</span>
                    </p>
                </div>

                <div class="price-categories">
                    <div class="price-category">
                        <h3 class="price-category-title">剪定</h3>
                        <p class="price-category-subtitle">1本から承ります。</p>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>低木1m未満</td>
                                        <td>¥700</td>
                                    </tr>
                                    <tr>
                                        <td>中低木 1m~2m未満</td>
                                        <td>￥1,500</td>
                                    </tr>
                                    <tr>
                                        <td>中木 2m~3m未満</td>
                                        <td>￥2,500</td>
                                    </tr>
                                    <tr>
                                        <td>高木 3m~5m未満</td>
                                        <td>￥5,000</td>
                                    </tr>
                                    <tr>
                                        <td>特別高木 5m~</td>
                                        <td>￥10,000～</td>
                                    </tr>
                                    <tr>
                                        <td>ゴミ処理（軽トラック一台）</td>
                                        <td>¥6,000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">伐採</h3>
                        <p class="price-category-subtitle">1本から承ります。</p>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>低木1m未満</td>
                                        <td>¥1,000</td>
                                    </tr>
                                    <tr>
                                        <td>中低木 1m~2m未満</td>
                                        <td>￥2,000</td>
                                    </tr>
                                    <tr>
                                        <td>中木 2m~3m未満</td>
                                        <td>￥3,000～</td>
                                    </tr>
                                    <tr>
                                        <td>高木 3m~5m未満</td>
                                        <td>￥10,000～¥20,000</td>
                                    </tr>
                                    <tr>
                                        <td>特別高木 5m~</td>
                                        <td>￥20,000～</td>
                                    </tr>
                                    <tr>
                                        <td>ゴミ処理（軽トラック一台）</td>
                                        <td>¥6,000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">消毒・除草・防草工事</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>消毒</td>
                                        <td>￥3,000～</td>
                                    </tr>
                                    <tr>
                                        <td>除草剤</td>
                                        <td>￥1,500～</td>
                                    </tr>
                                    <tr>
                                        <td>防草シート（平方メートル当たり）</td>
                                        <td>￥800～</td>
                                    </tr>
                                    <tr>
                                        <td>草刈（平方メートル当たり）</td>
                                        <td>￥200～</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="price-category">
                        <h3 class="price-category-title">庭工事</h3>
                        <div class="price-table-wrapper">
                            <table class="price-table">
                                <thead>
                                    <tr>
                                        <th>作業内容</th>
                                        <th>料金</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>砂利工事（平方メートル当たり）</td>
                                        <td>￥1,800～</td>
                                    </tr>
                                    <tr>
                                        <td>芝はり工事（平方メートル当たり）</td>
                                        <td>￥2,700～</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="price-note">
                    <p>
                        ※ 料金は作業内容やお庭の状態により異なります。<br />
                        ※ お見積もりは無料です。お気軽にご相談ください。<br />
                        ※ 詳細な料金については、お問い合わせフォームまたはお電話でお問い合わせください。
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 下部画像セクション -->
    <section class="prices-bottom-images u-section">
        <div class="container u-container">
            <div class="prices-bottom-grid">
                <div class="prices-bottom-image-item">
                    <a href="/images/niwanosentei-02s02.jpg" class="prices-image-link">
                        <img src="/images/niwanosentei-02s02.jpg" alt="庭の剪定" />
                    </a>
                </div>
                <div class="prices-bottom-image-item">
                    <a href="/images/konkuritodoma-02s02.jpg" class="prices-image-link">
                        <img src="/images/konkuritodoma-02s02.jpg" alt="建屋周辺作業後" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- お問い合わせセクション -->
    <section class="contact-section u-section">
        <div class="container u-container">
            <h3 class="contact-title fade-up">無料お見積だけでも<br />お気軽にお問い合わせください。</h3>
            <div class="divider fade-up"></div>
        </div>
    </section>

    <!-- お問い合わせボタン -->
    <section class="contact-buttons-section u-section">
        <div class="container u-container">
            <div class="contact-buttons-grid">
                <div class="contact-button-item">
                    <a href="tel:0925150747" class="fade-up">
                        <img src="/images/niwaya_tel_icon.png" alt="電話を掛ける" />
                    </a>
                </div>
                <div class="contact-button-item">
                    <a href="mailto:zouen@niwaya-syo.com" class="fade-up">
                        <img src="/images/niwaya_tel_icon_m.png" alt="メールを送信する" />
                    </a>
                </div>
            </div>
            <div class="contact-form-button">
                <a href="/contact" class="btn btn-primary">問い合わせ</a>
            </div>
            <div class="line-button-mobile">
                <a href="https://line.me/ti/p/N0BiuufFhv" class="btn btn-line">LINE 問い合わせ</a>
            </div>
        </div>
    </section>
</BaseLayout>
