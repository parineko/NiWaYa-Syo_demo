---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="店舗・飲食店 坪庭作り施工事例 - 福岡・粕屋の造園「庭や・笑」"
    description="福岡の飲食店・店舗エントランスを彩る坪庭施工事例。お客様を温かくもてなす植栽と照明、自然石を組み合わせた情緒ある空間デザイン。"
>
    <PageHeader title="店舗・飲食店 坪庭作り" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="店舗・飲食店 坪庭作り"
        images={[
            { src: '/images/momiji.jpg', alt: '店舗・飲食店 坪庭' }
        ]}
        description={[
            '店舗にこのような坪庭を取り入れることで、お客様に癒しの空間を提供できます。小さなスペースでも、植物と石を組み合わせることで、美しい坪庭を造ることができます。',
            '飲食店の坪庭は、お客様が食事を楽しむ際の雰囲気作りにも重要な役割を果たします。季節の移り変わりを感じられるような植栽を選び、一年を通じて楽しめる坪庭にしました。紅葉の季節には、美しい色づきを見せ、お客様にも好評をいただいております。'
        ]}
        prev={{ href: '/garden-tile', label: '庭のアプローチ' }}
        next={{ href: '/bamboo-fence-renovation', label: '竹垣のリフォーム' }}
    />
</BaseLayout>
