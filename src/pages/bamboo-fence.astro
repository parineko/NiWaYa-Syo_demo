---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="庭園 竹垣施工事例 - 福岡・粕屋の造園「庭や・笑」"
    description="職人の手技が光る本格的な竹垣施工事例。建仁寺垣や御簾垣などの伝統工法で、プライバシー保護と上質な和の風情を両立。"
>
    <PageHeader title="庭園 竹垣施工" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="庭園 竹垣施工"
        images={[
            { src: '/images/takegaki_sekou.jpg', alt: '庭園の竹垣' }
        ]}
        description={[
            '庭園に施された竹垣は、日本の伝統的な美しさを表現しています。竹の自然な風合いと、職人の技術により、美しい竹垣を造らせていただきました。',
            'お客様のご要望に合わせて、竹の種類や編み方を選定し、庭全体の雰囲気に調和する竹垣を施工いたしました。長年愛される、美しく機能的な竹垣となっております。'
        ]}
        prev={{ href: '/bamboo-fence-renovation', label: '竹垣のリフォーム' }}
        next={{ href: '/concrete-floor', label: '建屋周辺（コンクリート土間）' }}
    />
</BaseLayout>
