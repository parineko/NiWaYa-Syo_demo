---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="庭や笑について - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="about">
    <PageHeader title="庭や笑について" />

    <!-- モットー・理念（3行以内） -->
    <section class="motto-section u-section" style="padding: 10px 0 100px 0; background: #ffffff;">
        <div class="container u-container">
            <div style="text-align: center; max-width: 800px; margin: 0 auto;">
                <p class="zen-serif" style="font-size: 18px; line-height: 1.8; color: #2a2a2a; margin: 0 0 20px 0;">
                    「笑顔が活きる空間に」をモットーに、2016年に「庭や笑」として開業。<br /><br />和・洋にとらわれずお客様の生活スタイルに合わせた庭をご提案いたします。
                </p>
                <p class="zen-serif" style="font-size: 18px; line-height: 1.8; color: #2a2a2a; margin: 0;">
                    屋外に大小関係なく楽しんだり和んだりできる空間作り、人々が健やかに生きていけるように少しでも力になれればと思っております。
                </p>
            </div>
        </div>
    </section>

    <!-- 作業風景 -->
    <section class="work-scene-section u-section" style="padding: 40px 0 100px 0; background: #ffffff;">
        <div class="container u-container">
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; max-width: 1000px; margin: 40px auto 0 auto;">
                <figure style="margin: 0; height: 320px; border-radius: 10px; overflow: hidden;">
                    <img src="/images/takegakirifomu-04s03.jpg" alt="作業風景" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                </figure>
                <figure style="margin: 0; height: 320px; border-radius: 10px; overflow: hidden;">
                    <img src="/images/sagyoutyuu-01s03.jpg" alt="作業風景" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                </figure>
            </div>
        </div>
    </section>

    <!-- スタッフ紹介 -->
    <section class="staff-section u-section" style="padding: 100px 0; background: #ffffff;">
        <div class="container u-container">
            <h2 style="font-size: 32px; font-weight: 600; font-family: 'Shippori Mincho', serif; color: #000000; text-align: left; margin: 0 0 20px 0;">スタッフ紹介</h2>
            <div class="staff-grid u-grid">
                <div class="staff-card u-card fade-up">
                    <div class="staff-avatar">
                        <img src="/images/kasuya_zouen_fukuoka_001.5-300x300.jpg" alt="権藤 伸一郎" />
                    </div>
                    <div class="staff-info">
                        <h4 class="staff-name">
                            <div class="niwa">庭や・笑</div> 権藤 伸一郎
                        </h4>
                        <div class="staff-bio">
                            <p>樹形を生かした自然風な剪定が得意です。花や実、紅葉などの季節を感じて、庭を楽しんで頂けるように、心を込めて作業させて頂きます。よろしくお願い致します。</p>
                        </div>
                    </div>
                </div>
                <div class="staff-card u-card fade-up">
                    <div class="staff-avatar">
                        <img src="/images/kasuya_zouen_fukuoka_002.5-300x300.jpg" alt="権藤 辰仁" />
                    </div>
                    <div class="staff-info">
                        <h4 class="staff-name">
                            <div class="niwa">庭や・笑</div> 権藤 辰仁
                        </h4>
                        <div class="staff-bio">
                            <p>自然石を使った庭を造るのが好きです。色々な形をした石や植物とそこにちょっとした遊び心を入れながら、お客様が笑顔になって頂けるようなお庭を造らせて頂きます。</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- お客様の声 -->
    <section class="testimonials-section u-section" style="padding: 100px 0; background: #ffffff;">
        <div class="container u-container">
            <h2 style="font-size: 32px; font-weight: 600; font-family: 'Shippori Mincho', serif; color: #000000; text-align: left; margin: 0 0 20px 0;">お客様の声</h2>
            <ul class="testimonials-list" style="max-width: 800px; margin: 0 auto;">
                <li class="testimonial-item" style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div class="testimonial-title" style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">古賀市のお客様</div>
                    <p class="testimonial-text" style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">草刈りと話し相手にいつもありがとう。</p>
                </li>
                <li class="testimonial-item" style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div class="testimonial-title" style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">福岡市 N様</div>
                    <p class="testimonial-text" style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">庭の草刈り整地と砂利を引いてもらうだけでこんなにスッキリ広くなるとは思いませんでした。</p>
                </li>
                <li class="testimonial-item" style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div class="testimonial-title" style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">福岡県大野城市 T様</div>
                    <p class="testimonial-text" style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">整い過ぎず自然に、一部は綺麗に整えて、細かい注文に答えてもらいありがとうございます。</p>
                </li>
                <li class="testimonial-item" style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div class="testimonial-title" style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">福岡市 Y様</div>
                    <p class="testimonial-text" style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">初めて剪定を少しだけお願いしましたが、次の夏もまたお願いします。</p>
                </li>
            </ul>
        </div>
    </section>

    <FloatingContactButton currentPage="about" />
</BaseLayout>

