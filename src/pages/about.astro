---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="庭や笑について - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="about">
    <PageHeader title="庭や笑について" />

    <!-- モットー・理念（3行以内） -->
    <section class="motto-section u-section about-page-motto-section">
        <div class="container u-container">
            <div class="about-page-motto-wrapper">
                <p class="zen-serif about-page-motto-text">
                    「笑顔が活きる空間に」をモットーに、<br class="sp-only" />2016年に「庭や笑」として開業しました。
                </p>
                <p class="zen-serif about-page-motto-text">
                    和・洋にとらわれず、<br class="sp-only" />お客様の生活スタイルに合わせた庭をご提案いたします。
                </p>
                <p class="zen-serif about-page-motto-text">
                    屋外で大小にかかわらず、楽しんだり和んだりできる空間づくりを通して、<br class="sp-only" />人々が健やかに暮らせるよう、少しでも力になれればと思っております。
                </p>
                <p class="zen-serif about-page-motto-text">
                    私たちにとって庭とは、暮らしのそばで四季を映し、<br class="sp-only" />人の心を穏やかに整えてくれる場所です。
                </p>
                <p class="zen-serif about-page-motto-text">
                    眺め、佇み、語らい、季節を味わう。
                </p>
                <p class="zen-serif about-page-motto-text">
                    その場に居るだけで心が癒され安らげる、<br class="sp-only" />屋外空間すべてが庭だと思っています。
                </p>
                <p class="zen-serif about-page-motto-text">
                    お客様それぞれのニーズや暮らしに寄り添いながら、<br class="sp-only" />その土地に合った庭づくりを丁寧にプロデュースし、サポートしてまいります。
                </p>
            </div>
        </div>
    </section>

    <!-- 作業風景 -->
    <section class="work-scene-section u-section about-page-work-scene-section">
        <div class="container u-container">
            <div class="about-page-work-scene-grid">
                <figure class="about-page-work-scene-figure">
                    <img src="/images/takegakirifomu-04s03.jpg" alt="作業風景" />
                </figure>
                <figure class="about-page-work-scene-figure">
                    <img src="/images/sagyoutyuu-01s03.jpg" alt="作業風景" />
                </figure>
            </div>
        </div>
    </section>

    <!-- スタッフ紹介 -->
    <section class="staff-section u-section about-page-staff-section">
        <div class="container u-container">
            <h2 class="about-page-section-title">スタッフ紹介</h2>
            <div class="staff-grid u-grid">
                <div class="staff-card u-card fade-up">
                    <div class="staff-avatar">
                        <img src="/images/kasuya_zouen_fukuoka_001.5-300x300.jpg" alt="権藤 伸一郎" />
                    </div>
                    <div class="staff-info">
                        <h4 class="staff-name">
                            <div class="niwa">庭や・笑</div> 権藤 伸一郎
                        </h4>
                        <div class="staff-bio">
                            <p>樹形を生かした自然風な剪定が得意です。花や実、紅葉などの季節を感じて、庭を楽しんで頂けるように、心を込めて作業させて頂きます。よろしくお願い致します。</p>
                        </div>
                    </div>
                </div>
                <div class="staff-card u-card fade-up">
                    <div class="staff-avatar">
                        <img src="/images/kasuya_zouen_fukuoka_002.5-300x300.jpg" alt="権藤 辰仁" />
                    </div>
                    <div class="staff-info">
                        <h4 class="staff-name">
                            <div class="niwa">庭や・笑</div> 権藤 辰仁
                        </h4>
                        <div class="staff-bio">
                            <p>自然石を使った庭を造るのが好きです。色々な形をした石や植物とそこにちょっとした遊び心を入れながら、お客様が笑顔になって頂けるようなお庭を造らせて頂きます。</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- お客様の声 -->
    <section class="testimonials-section u-section about-page-testimonials-section">
        <div class="container u-container">
            <h2 class="about-page-section-title">お客様の声</h2>
            <ul class="testimonials-list about-page-testimonials-list">
                <li class="testimonial-item about-page-testimonial-item">
                    <div class="testimonial-title about-page-testimonial-title">古賀市のお客様</div>
                    <p class="testimonial-text about-page-testimonial-text">草刈りと話し相手にいつもありがとう。</p>
                </li>
                <li class="testimonial-item about-page-testimonial-item">
                    <div class="testimonial-title about-page-testimonial-title">福岡市 N様</div>
                    <p class="testimonial-text about-page-testimonial-text">庭の草刈り整地と砂利を引いてもらうだけでこんなにスッキリ広くなるとは思いませんでした。</p>
                </li>
                <li class="testimonial-item about-page-testimonial-item">
                    <div class="testimonial-title about-page-testimonial-title">福岡県大野城市 T様</div>
                    <p class="testimonial-text about-page-testimonial-text">整い過ぎず自然に、一部は綺麗に整えて、細かい注文に答えてもらいありがとうございます。</p>
                </li>
                <li class="testimonial-item about-page-testimonial-item">
                    <div class="testimonial-title about-page-testimonial-title">福岡市 Y様</div>
                    <p class="testimonial-text about-page-testimonial-text">初めて剪定を少しだけお願いしましたが、次の夏もまたお願いします。</p>
                </li>
            </ul>
        </div>
    </section>

    <FloatingContactButton currentPage="about" />
</BaseLayout>

