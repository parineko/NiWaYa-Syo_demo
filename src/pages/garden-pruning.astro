---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="庭木の剪定事例 - 福岡・粕屋の造園「庭や・笑」"
    description="福岡県粕屋町近郊の庭木剪定施工事例。伸び放題だった枝葉を丁寧に透かし剪定し、樹木の健康とお庭本来の美しい明るさを取り戻しました。"
>
    <PageHeader title="庭の剪定" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="庭の剪定"
        beforeAfter={{
            before: { src: '/images/niwanosentei-01s02.jpg', alt: '剪定前' },
            after: { src: '/images/niwanosentei-02s02.jpg', alt: '剪定後' }
        }}
        description={[
            '3年ほど手入れされていなかったお庭の剪定です。本来の綺麗なお庭が復活しました。長期間手入れされていない庭木は、見た目だけでなく、健康にも影響を与えることがあります。',
            '適切な剪定により、樹木の健康を回復し、お庭全体が明るく美しくなりました。お客様には、定期的な剪定の重要性をお伝えし、今後も美しいお庭を保っていただけるようサポートしております。'
        ]}
        next={{ href: '/tree-pruning', label: '高木の剪定' }}
    />
</BaseLayout>

