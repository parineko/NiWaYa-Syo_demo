---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="庭のアプローチ施工事例 - 福岡・粕屋の造園「庭や・笑」"
    description="自然石やタイル、敷石を活用した庭のアプローチ工事事例。雨の日でも歩きやすく、見た目も美しい園路をデザイン施工。"
>
    <PageHeader title="庭のアプローチ" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="庭のアプローチ"
        images={[
            { src: '/images/approach_02.jpg', alt: '庭のアプローチ' },
            { src: '/images/approach_01.jpg', alt: '庭のアプローチ' }
        ]}
        description={[
            '機能性と外観の両方を考慮して施工いたしました。アプローチ部分の通路は、お客様が毎日通る場所ですので、使いやすさと美しさを両立させることが重要です。',
            '自然石を使用することで、和風の落ち着いた雰囲気を演出し、植物との調和も図りました。お客様のご要望に合わせて、デザインや素材を選定し、世界に一つだけのアプローチを造らせていただきました。'
        ]}
        prev={{ href: '/weed-sheet-gravel', label: '防草シート・砂利敷き工事' }}
        next={{ href: '/shop-garden', label: '店舗・飲食店 坪庭作り' }}
    />
</BaseLayout>
