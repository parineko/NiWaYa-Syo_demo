---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout title="庭のアプローチ - 福岡 粕屋の造園 庭の事なら「庭や・笑」">
    <PageHeader title="庭のアプローチ" />
    
    <CaseStudyDetail
        title="庭のアプローチ"
        images={[
            { src: '/images/店舗_坪庭_アプローチ2.jpg', alt: '庭のアプローチ' },
            { src: '/images/店舗_坪庭_アプローチ1.jpg', alt: '庭のアプローチ' }
        ]}
        description={[
            '機能性と外観の両方を考慮して施工いたしました。アプローチ部分の通路は、お客様が毎日通る場所ですので、使いやすさと美しさを両立させることが重要です。',
            '自然石を使用することで、和風の落ち着いた雰囲気を演出し、植物との調和も図りました。お客様のご要望に合わせて、デザインや素材を選定し、世界に一つだけのアプローチを造らせていただきました。'
        ]}
        prev={{ href: '/weed-sheet-gravel', label: '防草シート・砂利敷き工事' }}
        next={{ href: '/shop-garden', label: '店舗・飲食店 坪庭作り' }}
    />
</BaseLayout>
