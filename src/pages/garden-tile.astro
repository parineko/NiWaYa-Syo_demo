---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="庭のアプローチ - 福岡 粕屋の造園 庭の事なら「庭や・笑」">
    <PageHeader title="庭のアプローチ" />
    
    <article class="blog-post u-section" style="padding: 100px 0;">
        <div class="container u-container">
            <div class="blog-post-content">
                <!-- 画像グリッド -->
                <div class="case-study-images-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 1000px; margin: 0 auto 60px;">
                    <figure class="case-study-image-wrapper" style="margin: 0;">
                        <img src="/images/店舗_坪庭_アプローチ2.jpg" alt="庭のアプローチ" style="width: 100%; height: auto; border-radius: 8px;" />
                    </figure>
                    <figure class="case-study-image-wrapper" style="margin: 0;">
                        <img src="/images/店舗_坪庭_アプローチ1.jpg" alt="庭のアプローチ" style="width: 100%; height: auto; border-radius: 8px;" />
                    </figure>
                </div>

                <!-- 説明文 -->
                <div class="blog-post-text" style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
                    <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; font-family: 'Noto Sans JP', sans-serif; margin-bottom: 20px;">
                        機能性と外観の両方を考慮して施工いたしました。アプローチ部分の通路は、お客様が毎日通る場所ですので、使いやすさと美しさを両立させることが重要です。
                    </p>
                    <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; font-family: 'Noto Sans JP', sans-serif;">
                        自然石を使用することで、和風の落ち着いた雰囲気を演出し、植物との調和も図りました。お客様のご要望に合わせて、デザインや素材を選定し、世界に一つだけのアプローチを造らせていただきました。
                    </p>
                </div>
            </div>

            <div class="blog-post-footer" style="text-align: center; margin-top: 60px;">
                <a href="/case-stady" class="btn btn-primary">施行例一覧に戻る</a>
            </div>

            <nav class="post-navigation" aria-label="投稿ナビゲーション" style="display: flex; justify-content: space-between; margin-top: 60px; max-width: 800px; margin-left: auto; margin-right: auto;">
                <a class="post-nav-link prev" href="/weed-sheet-gravel" style="color: #000000; text-decoration: none;">
                    <span class="nav-label" style="font-size: 14px; color: #666666;">← 前</span>
                    <span class="nav-title" style="display: block; margin-top: 5px; font-weight: 600;">防草シート・砂利敷き工事</span>
                </a>
                <a class="post-nav-link next" href="/shop-garden" style="color: #000000; text-decoration: none; text-align: right;">
                    <span class="nav-label" style="font-size: 14px; color: #666666;">次 →</span>
                    <span class="nav-title" style="display: block; margin-top: 5px; font-weight: 600;">店舗・飲食店 坪庭作り</span>
                </a>
            </nav>
        </div>
    </article>
</BaseLayout>
