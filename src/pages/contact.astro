---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="お問い合わせ - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="contact">
    <PageHeader title="お問い合わせ" subtitle="小さなことでも構いません。まずはお気軽にお問い合わせください。" />

    <section class="contact-form-section u-section contact-page-section">
        <div class="container u-container">
            <div class="contact-form-wrapper contact-page-wrapper">
                <!-- Googleフォーム -->
                <div class="contact-form contact-page-form-box">
                    <h2 class="section-title contact-page-title">お問い合わせフォーム</h2>

                    <p class="contact-page-text">
                        お名前・メールアドレス・ご相談内容だけで送信できます。<br />
                        基本は翌営業日までにご返信いたします。<br />
                        （Googleフォームは別ウィンドウで開きます）
                    </p>
                    
                    <div class="contact-page-button-wrapper">
                        <a href="https://docs.google.com/forms/d/e/1FAIpQLSdqZ3TjafK-d-3KYDk5MFFNeHYYmlyvGWDQU_hadHvuPA0iCw/viewform?usp=header" 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="btn btn-primary contact-button-animated contact-page-button">
                            Googleフォームでお問い合わせ
                        </a>
                    </div>
                </div>

                <!-- 電話・メール -->
                <div class="contact-info contact-page-info-box">
                    <h2 class="section-title contact-page-title">電話・メールでのお問い合わせ</h2>
                    
                    <p class="contact-page-text">
                        フォームが難しい場合やお急ぎの方は、電話・メールでも受付けております。<br />
                        営業時間外のご連絡は翌営業日に順次ご返信いたします。
                    </p>
                    
                    <div class="contact-methods contact-page-methods-grid">
                        <div class="contact-method contact-page-method-box">
                            <h3 class="contact-method-title contact-page-method-title">お電話</h3>
                            <p class="contact-page-method-text">受付時間：平日 9:00～18:00</p>
                            <a href="tel:0925150747" class="btn btn-primary contact-button-animated contact-page-button">
                                092-515-0747
                            </a>
                        </div>

                        <div class="contact-method contact-page-method-box">
                            <h3 class="contact-method-title contact-page-method-title">メール</h3>
                            <p class="contact-page-method-text">24時間受付（返信は営業時間内）</p>
                            <a href="mailto:zouen@niwaya-syo.com" class="btn btn-primary contact-button-animated contact-page-button">
                                zouen@niwaya-syo.com
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <FloatingContactButton currentPage="contact" />
</BaseLayout>

<style>
    @media (max-width: 768px) {
        .contact-methods {
            grid-template-columns: 1fr !important;
        }
        
        .contact-form,
        .contact-info {
            padding: 20px !important;
        }
        
        .section-title {
            font-size: 24px !important;
        }
    }
</style>
