---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';

// 全9件の施工事例データ（需要の高い順に整列）
const allCaseStudies = [
  {
    id: 'garden-pruning',
    title: '庭の剪定',
    category: '剪定・手入れ',
    image: '/images/niwanosentei-02s02.jpg',
    beforeImage: '/images/niwanosentei-01s02.jpg',
    desc: '伸びすぎた枝を落とし、樹木本来の美しい樹形と風通しを改善。定期的なお手入れでお庭を健やかに保ちます。',
    tag: 'Before & After 掲載',
    link: '/garden-pruning'
  },
  {
    id: 'tree-pruning',
    title: '高木の剪定・伐採',
    category: '高木・伐採',
    image: '/images/takagisentei-02s02.jpg',
    beforeImage: '/images/takagisentei-01s02.jpg',
    desc: '2階の屋根や電線、お隣の敷地に届きそうな危険な大木も、安全配慮を徹底して迅速に剪定・伐採いたします。',
    tag: 'Before & After 掲載',
    link: '/tree-pruning'
  },
  {
    id: 'weed-sheet-gravel',
    title: '防草シート・砂利敷き工事',
    category: '防草・美観',
    image: '/images/zouen2s02.jpg',
    beforeImage: '/images/zouen1s02.jpg',
    desc: '毎年の草むしりストレスから解放！高耐久防草シートと厳選砂利を敷設し、美観と防犯性を高めます。',
    tag: 'Before & After 掲載',
    link: '/weed-sheet-gravel'
  },
  {
    id: 'bamboo-fence-renovation',
    title: '竹垣のリフォーム',
    category: '竹垣改修',
    image: '/images/takegakirifomu-02s02.jpg',
    beforeImage: '/images/takegakirifomu-01s02.jpg',
    desc: '朽ちて傷んだ天然竹の垣根を、色褪せず高耐久な人工竹垣へと改修。お庭の目隠しと品格を長持ちさせます。',
    tag: 'Before & After 掲載',
    link: '/bamboo-fence-renovation'
  },
  {
    id: 'garden-tile',
    title: '庭のアプローチ・通路',
    category: '外構・アプローチ',
    image: '/images/approach_02.jpg',
    beforeImage: '/images/approach_01.jpg',
    desc: '毎日通る場所だからこそ、雨の日も歩きやすく情緒豊かな敷石動線を設計。和風・洋風どちらにも調和します。',
    tag: 'Before & After 掲載',
    link: '/garden-tile'
  },
  {
    id: 'shop-garden',
    title: '店舗・飲食店 坪庭作り',
    category: '坪庭・店舗',
    image: '/images/momiji.jpg',
    beforeImage: '/images/kasuya_zouen_fukuoka_004.jpg',
    desc: '限られたスペースや店舗のデッドスペースを、訪れるお客様を温かく迎える癒やしの和モダン空間へ。',
    tag: 'Before & After 掲載',
    link: '/shop-garden'
  },
  {
    id: 'bamboo-fence',
    title: '庭園 竹垣新設施工',
    category: '竹垣新設',
    image: '/images/takegaki_sekou.jpg',
    beforeImage: '/images/takegaki_sekou.jpg',
    desc: '建仁寺垣や御簾垣など、敷地の境界や背景を引き締める格式高い垣根を職人技で丹念に組み上げます。',
    tag: '新設施工',
    link: '/bamboo-fence'
  },
  {
    id: 'concrete-floor',
    title: 'コンクリート土間施工',
    category: '土間・駐車場',
    image: '/images/konkuritodoma-02s02.jpg',
    beforeImage: '/images/konkuritodoma-01s02.jpg',
    desc: '雑草が生えず車の出し入れもスムーズな土間コンクリート。駐輪場や物置スペースの舗装にも最適です。',
    tag: 'Before & After 掲載',
    link: '/concrete-floor'
  },
  {
    id: 'kadomatsu',
    title: '門松・正月飾り',
    category: '季節飾り',
    image: '/images/kadomatsu-01s03.jpg',
    beforeImage: '/images/kadomatsu-01s03.jpg',
    desc: '清々しい新年を迎えるための本格門松。企業様・店舗様・個人邸様向けに、心を込めて製作・設置いたします。',
    tag: '季節限定',
    link: '/kadomatsu'
  }
];
---

<BaseLayout
  title="施工事例一覧（全9件） - 福岡 粕屋の造園 庭の事なら「庭や・笑」"
  description="福岡・粕屋の造園「庭や・笑」の施工実績一覧。庭木剪定、高木伐採、防草シート・砂利敷き、竹垣リフォーム、坪庭などの施工ビフォーアフター事例をまとめてご覧いただけます。"
  currentPage="case-study"
>
  <PageHeader
    title="施工事例一覧"
    subtitle="庭や・笑が手掛けたお庭の剪定・造園・外構事例（全9件）です。"
  />

  <!-- 施工事例一覧（縦スクロールでじっくり見渡せるカタログフィード） -->
  <section class="section case-catalog-section">
    <div class="u-container">
      <div class="case-catalog-header fade-up">
        <span class="sub-label">WORKS ARCHIVE</span>
        <h2 class="sub-heading">施工実績（全9件）</h2>
        <p class="section-subtext">
          気になる事例をタップすると、施工前後の写真や詳細な解説をご覧いただけます。
        </p>
      </div>

      <!-- 施工事例カードグリッド -->
      <div class="case-grid">
        {allCaseStudies.map((item, index) => (
          <article class={`case-card fade-up delay-${((index % 3) + 1) * 100}`}>
            <a href={item.link} class="case-card-link">
              <div class="case-card-img-wrap">
                <span class="case-category-badge">{item.category}</span>
                <span class="case-tag-badge">{item.tag}</span>
                <img src={item.image} alt={item.title} class="case-card-img" loading="lazy" />
              </div>
              <div class="case-card-content">
                <h3 class="case-card-title">{item.title}</h3>
                <p class="case-card-desc">{item.desc}</p>
                <div class="case-card-footer">
                  <span class="case-card-btn">詳細・Before & Afterを見る &rarr;</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- お問い合わせ誘導＆戻るナビゲーション -->
      <div class="case-study-cta-box u-card fade-up">
        <h3 class="cta-box-title">施工事例のようなお庭のお悩み、お気軽にご相談ください</h3>
        <p class="cta-box-desc">
          「うちの庭も同じように整えたい」「1本だけの剪定だけど大丈夫？」など大歓迎です。<br class="pc-only" />
          職人直営のため、明確なお見積もりと誠実な施工をお約束いたします。
        </p>
        <div class="cta-box-actions">
          <a href="/#contact" class="u-btn cta-primary-btn">無料相談・お見積もりはこちら</a>
          <a href="/" class="u-btn u-btn--outline cta-secondary-btn">&larr; トップページに戻る</a>
        </div>
      </div>
    </div>
  </section>

  <FloatingContactButton currentPage="case-study" />
</BaseLayout>

<style>
  .case-catalog-section {
    padding: 40px 0 80px;
    background: #fbfdfb;
  }

  .case-catalog-header {
    text-align: center;
    margin-bottom: 44px;
  }

  .sub-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #4a5d4e;
    margin-bottom: 8px;
  }

  .sub-heading {
    font-size: clamp(1.8rem, 3.2vw, 2.3rem);
    font-family: 'Shippori Mincho', serif;
    font-weight: 700;
    color: #233427;
    margin: 0 0 12px;
  }

  .section-subtext {
    font-size: 0.95rem;
    color: #556658;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* 3カラムグリッド（タブレット2列、スマホ1列） */
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 60px;
  }

  .case-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    border: 1px solid #e2ebe4;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .case-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 34px rgba(43, 58, 47, 0.15);
    border-color: #c5d9c9;
  }

  .case-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .case-card-img-wrap {
    position: relative;
    width: 100%;
    height: 230px;
    overflow: hidden;
    background: #eef2ef;
  }

  .case-category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(30, 44, 34, 0.88);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 999px;
    z-index: 2;
    backdrop-filter: blur(4px);
  }

  .case-tag-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.92);
    color: #2b3a2f;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .case-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .case-card:hover .case-card-img {
    transform: scale(1.06);
  }

  .case-card-content {
    padding: 24px 22px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .case-card-title {
    font-size: 1.25rem;
    font-family: 'Shippori Mincho', serif;
    font-weight: 700;
    color: #233427;
    margin: 0 0 10px;
    line-height: 1.35;
  }

  .case-card-desc {
    font-size: 0.88rem;
    color: #556658;
    line-height: 1.7;
    margin: 0 0 18px;
    flex-grow: 1;
  }

  .case-card-footer {
    padding-top: 14px;
    border-top: 1px dashed #e8efe9;
  }

  .case-card-btn {
    font-weight: 700;
    color: #3c6e47;
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.2s ease;
  }

  .case-card:hover .case-card-btn {
    transform: translateX(4px);
  }

  /* 下部のお問い合わせボックス */
  .case-study-cta-box {
    text-align: center;
    padding: 44px 32px;
    border-radius: 20px;
    background: linear-gradient(135deg, #f4f8f4 0%, #e9f2eb 100%);
    border: 1px solid #d4e4d7;
  }

  .cta-box-title {
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-family: 'Shippori Mincho', serif;
    font-weight: 700;
    color: #233427;
    margin: 0 0 12px;
  }

  .cta-box-desc {
    font-size: 0.95rem;
    color: #556658;
    line-height: 1.8;
    max-width: 640px;
    margin: 0 auto 28px;
  }

  .cta-box-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta-primary-btn {
    padding: 14px 28px;
    font-size: 0.98rem;
  }

  .cta-secondary-btn {
    padding: 14px 24px;
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .case-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .case-catalog-section {
      padding: 30px 0 60px;
    }
    .case-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .case-card-img-wrap {
      height: 200px;
    }
    .case-card-content {
      padding: 20px 18px;
    }
    .case-study-cta-box {
      padding: 32px 18px;
    }
    .cta-box-actions {
      flex-direction: column;
      gap: 12px;
    }
    .cta-primary-btn,
    .cta-secondary-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
