---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout title="門松・正月飾り - 福岡 粕屋の造園 庭の事なら「庭や・笑」">
    <PageHeader title="門松・正月飾り" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="門松・正月飾り"
        images={[
            { src: '/images/kadomatsu-01s03.jpg', alt: '門松' }
        ]}
        singleImageStyle="kadomatsu"
        description={[
            '店舗や個人邸向け、気軽に門松・正月飾りをしたい方へ。お正月の伝統的な飾りとして、新年を迎える準備をお手伝いいたします。卓上門松から大型の門松まで、お客様のご要望に合わせてご提案いたします。',
            'ご依頼があれば年明け7日以降に回収まで対応いたします。お正月の期間中、美しい門松で新年をお迎えください。設置から回収まで、安心してお任せください。'
        ]}
        prev={{ href: '/concrete-floor', label: '建屋周辺（コンクリート土間）' }}
    />
</BaseLayout>

