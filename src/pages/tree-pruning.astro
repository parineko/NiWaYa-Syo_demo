---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="高木の剪定事例 - 福岡・粕屋の造園「庭や・笑」"
    description="手の届かない高木・巨木の剪定事例。電線や隣家への越境に配慮しつつ、樹形を美しく整えるプロの剪定技術で安全に仕上げました。"
>
    <PageHeader title="高木の剪定" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="高木の剪定"
        beforeAfter={{
            before: { src: '/images/takagisentei-01s02.jpg', alt: '剪定前' },
            after: { src: '/images/takagisentei-02s02.jpg', alt: '剪定後' }
        }}
        description={[
            'お客様が手の届かない高木の剪定依頼です。自然な雰囲気を保ちながら、剪定の好みを細かくお伺いし作業しました。高木の剪定は安全に配慮しながら、樹形を美しく整えることが重要です。',
            'お客様のご要望に合わせて、樹木の健康を保ちながら、見た目も美しく整える剪定を心がけています。剪定後は、お庭全体がすっきりと明るくなり、お客様に喜んでいただいております。'
        ]}
        prev={{ href: '/garden-pruning', label: '庭の剪定' }}
        next={{ href: '/weed-sheet-gravel', label: '防草シート・砂利敷き工事' }}
    />
</BaseLayout>

