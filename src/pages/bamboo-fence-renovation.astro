---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout
    title="竹垣のリフォーム事例 - 福岡・粕屋の造園「庭や・笑」"
    description="老朽化した天然竹垣を高耐久な人工強化竹垣へリフォームした事例。風情ある和の美しさはそのままに、長期間腐食しない耐久性を実現しました。"
>
    <PageHeader title="竹垣のリフォーム" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="竹垣のリフォーム"
        beforeAfter={{
            before: { src: '/images/takegakirifomu-01s02.jpg', alt: 'リフォーム前' },
            after: { src: '/images/takegakirifomu-02s02.jpg', alt: 'リフォーム後' }
        }}
        description={[
            '長年使用していた竹垣が老朽化していたため、新しい竹材を使用してリフォームいたしました。日本の伝統的な美しさを保ちながら、より耐久性の高い仕上がりに生まれ変わりました。',
            'お客様のご要望に合わせて、竹の種類や編み方を選定し、庭全体の雰囲気に調和する竹垣を施工いたしました。リフォーム後は、美しい見た目と機能性を兼ね備えた、長く愛される竹垣となりました。'
        ]}
        prev={{ href: '/shop-garden', label: '店舗・飲食店 坪庭作り' }}
        next={{ href: '/bamboo-fence', label: '庭園 竹垣施工' }}
    />
</BaseLayout>

