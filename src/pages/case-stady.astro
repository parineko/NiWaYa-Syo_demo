---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="施行例 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="case-stady">
    <PageHeader title="施行例" />

    <!-- 紹介文 -->
    <section class="case-intro-section u-section" style="padding: 100px 0; background: #ffffff;">
        <div class="container u-container">
            <h2 style="font-size: 32px; font-weight: 600; font-family: 'Noto Serif JP', serif; color: #000000; text-align: center; margin-top: 40px; margin-bottom: 20px;">
                庭や・笑のこれまでの施工事例を紹介いたします。
            </h2>
        </div>
    </section>

    <!-- 主要施工例スライダー -->
    <section class="case-study-slider-section u-section" style="padding: 100px 0; background: #f5f5f5;">
        <div class="container u-container">
            <CaseStudySlider client:load />
        </div>
    </section>

    <!-- 防草シート・砂利敷き工事 -->
    <section class="case-study-section u-section" style="padding: 100px 0; background: #f5f5f5;">
        <div class="container u-container">
            <h2 class="case-study-title-large" style="color: #000000; font-family: 'Noto Serif JP', serif; text-align: center; margin-top: 40px; margin-bottom: 20px;">防草シート・砂利敷き工事</h2>
            <div class="case-before-after" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 800px; margin: 0 auto;">
                <figure style="margin: 0;">
                    <img src="/images/zouen1s02.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">Before</figcaption>
                </figure>
                <figure style="margin: 0;">
                    <img src="/images/zouen2s02.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 竹垣のリフォーム -->
    <section class="case-study-section u-section" style="padding: 100px 0; background: #ffffff;">
        <div class="container u-container">
            <h2 class="case-study-title-large" style="color: #000000; font-family: 'Noto Serif JP', serif; text-align: center; margin-top: 40px; margin-bottom: 20px;">竹垣のリフォーム</h2>
            <div class="case-before-after" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 800px; margin: 0 auto;">
                <figure style="margin: 0;">
                    <img src="/images/takegakirifomu-01s02.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">Before</figcaption>
                </figure>
                <figure style="margin: 0;">
                    <img src="/images/takegakirifomu-02s02.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 門松・正月飾り（最下部に移動） -->
    <section class="case-study-section u-section" style="padding: 100px 0; background: #f5f5f5;">
        <div class="container u-container">
            <h2 class="case-study-title-large" style="color: #000000; font-family: 'Noto Serif JP', serif; text-align: center; margin-top: 40px; margin-bottom: 20px;">門松・正月飾り</h2>
            <p class="case-study-note" style="text-align: center; color: #2a2a2a; font-family: 'Noto Sans JP', sans-serif; margin-bottom: 40px;">
                店舗や個人邸向け、気軽に門松・正月飾りをしたい方へ。ご依頼があれば年明け7日以降に回収まで対応いたします。
            </p>
            <div class="case-gallery" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 800px; margin: 0 auto;">
                <figure style="margin: 0;">
                    <img src="/images/kadomatsu.03.jpg" alt="卓上門松" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">卓上門松（4,800円）</figcaption>
                </figure>
                <figure style="margin: 0;">
                    <img src="/images/kadomatsu-01s03.jpg" alt="門松" style="width: 100%; height: auto; border-radius: 8px;" />
                    <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">門松（設置例）</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <FloatingContactButton />
</BaseLayout>
