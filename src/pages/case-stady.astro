---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<BaseLayout title="施行例 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="case-stady">
    <PageHeader title="施行例" />

    <!-- 紹介文 -->
    <section class="case-intro-section u-section">
        <div class="container u-container">
            <h4 class="case-intro-text">庭や・笑のこれまでの施工事例を紹介いたします。</h4>
        </div>
    </section>

    <!-- 庭園 竹垣施工 -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">庭園 竹垣施工<span class="kadomastu1"></span></h2>
            <div class="case-study-image-wrapper">
                <img src="/images/竹垣施工.jpg" alt="" class="case-study-image" />
            </div>
            <p class="case-study-description" style="text-align: center; margin-top: 20px;">
                <a href="/bamboo-fence" class="btn btn-primary">詳しくはこちら</a>
            </p>
        </div>
    </section>

    <!-- 庭のアプローチ -->
    <section class="case-study-section u-section">
        <div class="container u-container">
            <h2 class="case-study-title-large">庭のアプローチ<span class="kadomastu1"></span></h2>
            <div class="case-study-images-grid">
                <div class="case-study-image-wrapper">
                    <img src="/images/店舗_坪庭_アプローチ2.jpg" alt="" class="case-study-image" />
                </div>
                <div class="case-study-image-wrapper">
                    <img src="/images/店舗_坪庭_アプローチ1.jpg" alt="" class="case-study-image" />
                </div>
            </div>
            <p class="case-study-description" style="text-align: center; margin-top: 20px;">
                <a href="/garden-tile" class="btn btn-primary">詳しくはこちら</a>
            </p>
        </div>
    </section>

    <!-- 坪庭施工 -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">坪庭施工<span class="kadomastu1"></span></h2>
            <div class="case-study-image-wrapper">
                <img src="/images/紅葉.jpg" alt="" class="case-study-image" />
            </div>
            <p class="case-study-description" style="text-align: center; margin-top: 20px;">
                <a href="/shop-garden" class="btn btn-primary">詳しくはこちら</a>
            </p>
        </div>
    </section>

    <!-- 卓上門松 -->
    <section class="case-study-section u-section">
        <div class="container u-container">
            <h2 class="case-study-title-large">卓上門松 <span class="case-title-sub">4,800円</span></h2>
            <div class="case-gallery case-gallery-three">
                <figure>
                    <img src="/images/kadomatsu.03.jpg" alt="" />
                    <figcaption>卓上門松（完成品）</figcaption>
                </figure>
                <figure>
                    <img src="/images/kadomatsu.zouen2s03.jpg" alt="" />
                    <figcaption>卓上門松（別角度）</figcaption>
                </figure>
                <figure>
                    <img src="/images/kadomatsu.zouen3s03.jpg" alt="" />
                    <figcaption>卓上門松（装飾例）</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 門松 -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">門　松</h2>
            <p class="case-study-note"><strong>店舗や個人邸向け、気軽に門松・正月飾りをしたい方へ。ご依頼があれば年明け7日以降に回収まで対応いたします。</strong></p>
            <div class="case-gallery case-gallery-three">
                <figure>
                    <img src="/images/kadomatsu-01s03.jpg" alt="" />
                    <figcaption>門松（設置例）</figcaption>
                </figure>
                <figure>
                    <img src="/images/kadomatu-02s03.jpg" alt="" />
                    <figcaption>門松（ペア設置）</figcaption>
                </figure>
                <figure>
                    <img src="/images/kadomatu-03s03.jpg" alt="" />
                    <figcaption>門松（大型タイプ）</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 防草シート・砂利敷き工事 -->
    <section class="case-study-section u-section">
        <div class="container u-container">
            <h2 class="case-study-title-large">防草シート・砂利敷き工事（建屋周辺）</h2>
            <p class="case-study-description">草と虫に悩まされていたお客様の家周辺の草刈りとお手入れを行い、全体に砂利を敷き詰めました。その他ご要望にもお応えできます。お気軽にご相談ください。</p>
            <div class="case-before-after">
                <figure>
                    <img src="/images/zouen1s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/zouen2s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-before-after">
                <figure>
                    <img src="/images/zouen3s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/zouen4s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-before-after">
                <figure>
                    <img src="/images/zouen5s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/zouen6s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-before-after">
                <figure>
                    <img src="/images/zouen7s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/zouen8s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-gallery case-gallery-single">
                <figure>
                    <img src="/images/zouen9s01.jpg" alt="" />
                    <figcaption>After（あらゆるご要望に対応します）</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 竹垣のリフォーム -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">竹垣のリフォーム</h2>
            <p class="case-study-description">お庭の雰囲気や大きさに合わせて、竹垣をフルリフォームしました。素材づくりから組み立てまで、すべて自社施工です。</p>
            <div class="case-before-after">
                <figure>
                    <img src="/images/takegakirifomu-01s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/takegakirifomu-02s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-gallery case-gallery-three">
                <figure>
                    <img src="/images/takegakirifomu-03s03.jpg" alt="" />
                    <figcaption>素材の制作</figcaption>
                </figure>
                <figure>
                    <img src="/images/takegakirifomu-04s03.jpg" alt="" />
                    <figcaption>竹垣の組み立て</figcaption>
                </figure>
                <figure>
                    <img src="/images/takegakirifomu-05s03.jpg" alt="" />
                    <figcaption>仕上げ工程</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 坪庭リフォーム Before/After -->
    <section class="case-study-section u-section">
        <div class="container u-container">
            <div class="case-before-after">
                <figure>
                    <img src="/images/fukuoka_zouen_r102.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/fukuoka_zouen_r103.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
            <div class="case-before-after">
                <figure>
                    <img src="/images/fukuoka_zouen_r104.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/fukuoka_zouen_r101.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 高木の剪定 -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">高木の剪定</h2>
            <p class="case-study-description">お客様が手の届かない高木の剪定依頼です。自然な雰囲気を保ちながら、剪定の好みを細かくお伺いし作業しました。</p>
            <div class="case-before-after">
                <figure>
                    <img src="/images/takagisentei-01s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/takagisentei-02s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 庭の剪定 -->
    <section class="case-study-section u-section">
        <div class="container u-container">
            <h2 class="case-study-title-large">庭の剪定</h2>
            <p class="case-study-description">3年ほど手入れされていなかったお庭の剪定です。本来の綺麗なお庭が復活しました。</p>
            <div class="case-before-after">
                <figure>
                    <img src="/images/niwanosentei-01s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/niwanosentei-02s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- 建屋周辺 -->
    <section class="case-study-section u-section u-section--alt">
        <div class="container u-container">
            <h2 class="case-study-title-large">建屋周辺</h2>
            <p class="case-study-description">草と虫に悩まされていた建屋周辺をコンクリート土間で仕上げました。一部に砂利を入れるなど、ご要望に合わせた施工が可能です。</p>
            <div class="case-before-after">
                <figure>
                    <img src="/images/konkuritodoma-01s02.jpg" alt="" />
                    <figcaption>Before</figcaption>
                </figure>
                <figure>
                    <img src="/images/konkuritodoma-02s02.jpg" alt="" />
                    <figcaption>After</figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- お問い合わせCTA -->
    <ContactCTA />
</BaseLayout>
