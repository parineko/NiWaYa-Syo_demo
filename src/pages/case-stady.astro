---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="施行例 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="case-stady">
    <!-- タイトルと紹介文（1行） -->
    <section class="case-intro-section u-section" style="padding: 10px 0 20px 0 !important; margin-bottom: 0 !important; background: #f8f8f8;">
        <div class="container u-container">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h1 style="font-size: 28px; font-weight: 600; font-family: 'Noto Serif JP', serif; color: #000000; margin: 0;">
                    施行例
                </h1>
                <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">
                    庭や・笑のこれまでの施工事例を紹介いたします。
                </p>
            </div>
        </div>
    </section>

    <!-- 主要施工例スライダー -->
    <section class="case-study-slider-section u-section" style="padding: 20px 0 0 0 !important; margin-bottom: 0 !important; background: #f8f8f8 !important; padding-bottom: 0 !important;">
        <div class="container u-container" style="padding-bottom: 0;">
            <CaseStudySlider client:load />
        </div>
    </section>

    <FloatingContactButton />
</BaseLayout>
