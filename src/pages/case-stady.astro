---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="施行例 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="case-stady">
    <PageHeader title="施行例" />

    <!-- 紹介文 -->
    <section class="case-intro-section u-section" style="padding: 10px 0 100px 0; background: #ffffff;">
        <div class="container u-container">
            <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; font-family: 'Noto Sans JP', sans-serif; text-align: center; margin: 0 0 40px 0;">
                庭や・笑のこれまでの施工事例を紹介いたします。
            </p>
        </div>
    </section>

    <!-- 主要施工例スライダー -->
    <section class="case-study-slider-section u-section" style="padding: 100px 0; background: #f5f5f5;">
        <div class="container u-container">
            <CaseStudySlider client:load />
        </div>
    </section>

    <FloatingContactButton />
</BaseLayout>
