---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="施行例 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="case-stady">
    <PageHeader title="施行例" subtitle="これまでに承った施工事例の一部をご紹介します。" />

    <!-- 主要施工例スライダー -->
    <section class="case-study-slider-section u-section" style="padding: 20px 0 0 0 !important; margin-bottom: 0 !important; background: #f8f8f8 !important; padding-bottom: 0 !important;">
        <div class="container u-container" style="padding-bottom: 0;">
            <CaseStudySlider client:load />
        </div>
    </section>

    <FloatingContactButton currentPage="case-stady" />
</BaseLayout>
