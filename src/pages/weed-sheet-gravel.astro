---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout title="防草シート・砂利敷き工事 - 福岡 粕屋の造園 庭の事なら「庭や・笑」">
    <PageHeader title="防草シート・砂利敷き工事" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="防草シート・砂利敷き工事"
        beforeAfter={{
            before: { src: '/images/zouen1s02.jpg', alt: '施工前' },
            after: { src: '/images/zouen2s02.jpg', alt: '施工後' }
        }}
        description={[
            '雑草が生い茂っていたお庭に、防草シートと砂利を敷き詰めることで、メンテナンスが簡単で美しい空間に生まれ変わりました。防草シートは雑草の成長を抑え、砂利は見た目も美しく、歩きやすい地面を実現します。',
            'お客様のご要望に合わせて、砂利の種類や色を選定し、お庭全体の雰囲気に調和する仕上がりにいたしました。これにより、草刈りの手間が大幅に減り、お客様に喜んでいただいております。'
        ]}
        prev={{ href: '/tree-pruning', label: '高木の剪定' }}
        next={{ href: '/garden-tile', label: '庭のアプローチ' }}
    />
</BaseLayout>

