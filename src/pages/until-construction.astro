---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<BaseLayout title="受付から施行まで - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="until-construction">
    <PageHeader title="お庭のお手入れ施工終了まで安心してお任せ下さい。" />

    <!-- トップ画像 -->
    <section class="process-top-image u-section u-section--tight">
        <div class="container u-container">
            <div class="process-hero-image">
                <img src="/images/uketukekarasekoumade-01s01.jpg" alt="受付から施工まで" />
            </div>
        </div>
    </section>

    <!-- イントロテキスト -->
    <section class="process-intro u-section u-section--alt">
        <div class="container u-container">
            <p class="process-intro-text">
                お客様が<strong>心が癒され安らげる</strong>屋外空間を造らせていただきます。
            </p>
        </div>
    </section>

    <!-- モットー -->
    <section class="process-motto u-section">
        <div class="container u-container">
            <h2 class="process-motto-title" style="font-size: 1.8rem;">
                「庭や・笑」 <span class="motto-highlight">笑顔が活きる</span> 空間
            </h2>
        </div>
    </section>

    <section class="process-section u-section u-section--alt">
        <div class="container u-container">
            <div class="process-content">
                <h2 class="section-title fade-up">ご依頼から完成までの流れ</h2>
                <div class="divider fade-up"></div>

                <div class="process-steps">
                    <div class="process-step process-step-with-bg" style="background-image: url('/images/otoiawase-01_middle.png');">
                        <div class="step-content">
                            <h3 class="step-title">
                                <span class="step1">Step.1　電話または、メールにてご連絡下さい。</span>
                            </h3>
                        </div>
                    </div>

                    <div class="process-step process-step-with-bg" style="background-image: url('/images/omitumori-01_middle.jpg');">
                        <div class="step-content">
                            <h3 class="step-title">
                                <span class="step1">Step.2　お客様のお家などにお伺いして、詳細なご要望をお聞きします。</span>
                            </h3>
                        </div>
                    </div>

                    <div class="process-step process-step-with-bg" style="background-image: url('/images/sagyou-01_middle.png');">
                        <div class="step-content">
                            <h3 class="step-title">
                                <span class="step1">Step.3　ご都合のよい施工日を決めていただき、当日作業いたします。</span>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- お問い合わせCTA -->
    <ContactCTA />
</BaseLayout>
