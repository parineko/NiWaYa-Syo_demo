---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseStudyDetail from '../components/CaseStudyDetail.astro';
---

<BaseLayout title="コンクリート土間施工 - 福岡 粕屋の造園 庭の事なら「庭や・笑」">
    <PageHeader title="コンクリート土間施工" backHref="/#works" backText="トップページ（施工実績）に戻る" />
    
    <CaseStudyDetail
        title="コンクリート土間施工"
        beforeAfter={{
            before: { src: '/images/konkuritodoma-01s02.jpg', alt: '施工前' },
            after: { src: '/images/konkuritodoma-02s02.jpg', alt: '施工後' }
        }}
        description={[
            '草と虫に悩まされていた建屋周辺をコンクリート土間で仕上げました。コンクリート土間は、メンテナンスが簡単で、清潔感のある空間を実現します。一部に砂利を入れるなど、ご要望に合わせた施工が可能です。',
            'お客様のご要望に合わせて、デザインや素材を選定し、使いやすく美しい建屋周辺を造らせていただきました。施工後は、草刈りの手間がなくなり、お客様に喜んでいただいております。'
        ]}
        prev={{ href: '/bamboo-fence', label: '庭園 竹垣施工' }}
        next={{ href: '/kadomatsu', label: '門松・正月飾り' }}
    />
</BaseLayout>

