---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout
    title="お庭でお困りの方へ - 剪定・伐採・草刈り・庭清掃 | 福岡「庭や・笑」"
    description="庭木や雑草が伸びすぎた、水たまりができる、駐車場にリフォームしたいなど、お庭のお悩みを福岡・粕屋の庭師「庭や・笑」が迅速・丁寧に解決いたします。"
    currentPage="trouble"
>
    <PageHeader title="お庭でお困りの方へ" subtitle="季節や暮らしに合わせて増えるお庭のお悩みをまとめました。" backHref="/#trouble" backText="トップページへ戻る" />

    <section class="trouble-section u-section trouble-page-section">
        <div class="container u-container">
            <div class="trouble-content">

                <div class="trouble-list trouble-page-list">
                    <div class="trouble-item trouble-page-item">
                        <h3 class="trouble-item-title trouble-page-item-title">庭木・雑草が伸びすぎて手に負えない</h3>
                        <p class="trouble-item-description trouble-page-item-description">剪定・伐採・草刈・防草工事までまとめて対応いたします。長期間手入れされていない庭木や雑草も、適切な方法で美しく整えます。</p>
                    </div>
                    <div class="trouble-item trouble-page-item">
                        <h3 class="trouble-item-title trouble-page-item-title">お庭に水たまりができる</h3>
                        <p class="trouble-item-description trouble-page-item-description">庭土の整地工事で、水はけの良い地面に改善いたします。雨の日でも快適に過ごせるお庭に生まれ変わります。</p>
                    </div>
                    <div class="trouble-item trouble-page-item">
                        <h3 class="trouble-item-title trouble-page-item-title">お庭にキレイな花や木を植えたい</h3>
                        <p class="trouble-item-description trouble-page-item-description">花壇造りや植栽工事で、季節を感じる空間をご提案します。お客様のご要望に合わせた植物選びから、植栽までトータルサポートいたします。</p>
                    </div>
                    <div class="trouble-item trouble-page-item">
                        <h3 class="trouble-item-title trouble-page-item-title">お庭だった所を駐車場にしたい</h3>
                        <p class="trouble-item-description trouble-page-item-description">土間工事・石張り工事で、使いやすい駐車場に生まれ変わります。コンクリートや自然石など、お好みの素材で施工いたします。</p>
                    </div>
                    <div class="trouble-item trouble-page-item">
                        <h3 class="trouble-item-title trouble-page-item-title">お庭をもっと好みの風景にしたい</h3>
                        <p class="trouble-item-description trouble-page-item-description">お庭のリフォーム工事で、理想の景色を実現いたします。既存の庭を活かしながら、お客様のイメージに合わせてリニューアルいたします。</p>
                    </div>
                </div>

                <div class="before-after-grid trouble-page-before-after">
                    <figure class="trouble-page-figure">
                        <img src="/images/zouen_sagyou_02.jpg" alt="施工前の庭" />
                        <figcaption class="trouble-page-figcaption">Before</figcaption>
                    </figure>
                    <figure class="trouble-page-figure">
                        <img src="/images/zouen_sagyou_03.jpg" alt="施工後の庭" />
                        <figcaption class="trouble-page-figcaption">After</figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </section>

    <!-- ご依頼の流れ -->
    <section class="process-section u-section process-page-section">
        <div class="container u-container">
            <div class="page-header-row">
                <h2 class="page-title process-page-title">ご依頼の進め方</h2>
                <p class="page-subtitle">お問い合わせから施工終了まで、安心してお任せください。</p>
                </div>
            <div class="process-page-steps-wrapper">
                <div class="process-page-step-box">
                    <div class="process-page-step-title">Step.1 お問い合わせ</div>
                    <p class="process-page-step-text">お問い合わせフォームからご記入ください。電話・メールでも受け付けております。</p>
                </div>
                <div class="process-page-step-box">
                    <div class="process-page-step-title">Step.2 お見積もり</div>
                    <p class="process-page-step-text">お客様のお家などにお伺いして、詳細なご要望をお聞きします。</p>
                </div>
                <div class="process-page-step-box">
                    <div class="process-page-step-title">Step.3 施工</div>
                    <p class="process-page-step-text">ご都合のよい施工日を決めていただき、当日作業いたします。</p>
                </div>
            </div>
        </div>
    </section>

    <FloatingContactButton currentPage="trouble" />
</BaseLayout>
