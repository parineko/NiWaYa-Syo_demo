---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="お庭でお困りの方 - 福岡 粕屋の造園 庭の事なら「庭や・笑」" currentPage="trouble">
    <PageHeader title="お庭でお困りの方へ" subtitle="季節や暮らしに合わせて増えるお庭のお悩みをまとめました。" />

    <section class="trouble-section u-section" style="padding: 10px 0 100px 0; background: #ffffff;">
        <div class="container u-container">
            <div class="trouble-content">

                <div class="trouble-list" style="max-width: 800px; margin: 0 auto 60px;">
                    <div class="trouble-item" style="margin-bottom: 30px; padding: 30px; background: #f5f5f5; border-radius: 8px;">
                        <h3 class="trouble-item-title" style="font-size: 20px; font-weight: 600; color: #000000; margin-bottom: 10px;">庭木・雑草が伸びすぎて手に負えない</h3>
                        <p class="trouble-item-description" style="font-size: 16px; line-height: 1.8; color: #2a2a2a;">剪定・伐採・草刈・防草工事までまとめて対応いたします。</p>
                    </div>
                    <div class="trouble-item" style="margin-bottom: 30px; padding: 30px; background: #f5f5f5; border-radius: 8px;">
                        <h3 class="trouble-item-title" style="font-size: 20px; font-weight: 600; color: #000000; margin-bottom: 10px;">お庭にキレイな花や木を植えたい</h3>
                        <p class="trouble-item-description" style="font-size: 16px; line-height: 1.8; color: #2a2a2a;">花壇造りや植栽工事で、季節を感じる空間をご提案します。</p>
                    </div>
                    <div class="trouble-item" style="margin-bottom: 30px; padding: 30px; background: #f5f5f5; border-radius: 8px;">
                        <h3 class="trouble-item-title" style="font-size: 20px; font-weight: 600; color: #000000; margin-bottom: 10px;">お庭をもっと好みの風景にしたい</h3>
                        <p class="trouble-item-description" style="font-size: 16px; line-height: 1.8; color: #2a2a2a;">お庭のリフォーム工事で、理想の景色を実現いたします。</p>
                    </div>
                </div>

                <div class="before-after-grid" style="max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <figure style="margin: 0;">
                        <img src="/images/zouen_sagyou_02.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                        <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">Before</figcaption>
                    </figure>
                    <figure style="margin: 0;">
                        <img src="/images/zouen_sagyou_03.jpg" alt="" style="width: 100%; height: auto; border-radius: 8px;" />
                        <figcaption style="text-align: center; margin-top: 10px; color: #2a2a2a;">After</figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </section>

    <!-- ご依頼の流れ -->
    <section class="process-section u-section" style="padding: 100px 0; background: #ffffff;">
        <div class="container u-container">
            <div class="page-header-row">
                <h2 class="page-title" style="font-size: 28px;">ご依頼の進め方</h2>
                <p class="page-subtitle">お問い合わせから施工当日までの流れをご案内します。</p>
                </div>
            <div style="max-width: 800px; margin: 0 auto; margin-top: 40px;">
                <div style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">Step.1 お問い合わせ</div>
                    <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">お問い合わせフォームからご記入ください。電話・メールでも受け付けております。</p>
                </div>
                <div style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">Step.2 お見積もり</div>
                    <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">お客様のお家などにお伺いして、詳細なご要望をお聞きします。</p>
                </div>
                <div style="margin-bottom: 20px; padding: 20px; background: #f8f8f8; border-radius: 8px; border-left: 4px solid #666666;">
                    <div style="font-size: 18px; font-weight: 600; color: #000000; margin-bottom: 8px; font-family: 'Shippori Mincho', serif;">Step.3 施工</div>
                    <p style="font-size: 16px; line-height: 1.8; color: #2a2a2a; margin: 0;">ご都合のよい施工日を決めていただき、当日作業いたします。</p>
                </div>
            </div>
        </div>
    </section>

    <FloatingContactButton currentPage="trouble" />
</BaseLayout>
