---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="福岡 粕屋の造園 庭の事なら「庭や・笑」（にわやしょう）" currentPage="home">
    <!-- ヒーロースライダー -->
    <HeroSlider />

    <!-- モットーセクション -->
    <section class="motto-section u-section index-page-motto-section">
        <div class="container u-container">
            <div class="index-page-motto-wrapper">
                <p class="index-page-motto-text">
                    庭の魅力を丁寧に引き出し、整えるお手伝いをしています。
                </p>
                <p class="index-page-motto-text index-page-motto-text-last">
                    剪定・造園・お手入れまで幅広く対応いたします。
                </p>
            </div>
        </div>
    </section>

    <FloatingContactButton currentPage="home" />

    <script>
        import initHeroSlider from '../scripts/initHeroSlider';
        
        if (typeof window !== 'undefined') {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initHeroSlider);
            } else {
                initHeroSlider();
            }
        }
    </script>
</BaseLayout>

