---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="福岡 粕屋の造園 庭の事なら「庭や・笑」（にわやしょう）" currentPage="home">
    <!-- ヒーロースライダー -->
    <HeroSlider client:load />

    <!-- モットーセクション -->
    <section class="motto-section u-section" style="padding: 10px 0 0 !important; margin-bottom: 0 !important; min-height: auto !important; background: #ffffff;">
        <div class="container u-container">
            <div style="text-align: center;">
                <p style="font-size: 27px; line-height: 2.0; color: #2a2a2a; font-family: 'Noto Serif JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif; margin: 0 0 10px 0; letter-spacing: 0.05em;">
                    庭の魅力を丁寧に引き出し、整えるお手伝いをしています。
                </p>
                <p style="font-size: 27px; line-height: 2.0; color: #2a2a2a; font-family: 'Noto Serif JP', 'Yu Mincho', 'Hiragino Mincho ProN', serif; margin: 0; letter-spacing: 0.05em;">
                    剪定・造園・お手入れまで幅広く対応いたします。
                </p>
            </div>
        </div>
    </section>

    <FloatingContactButton />
</BaseLayout>

