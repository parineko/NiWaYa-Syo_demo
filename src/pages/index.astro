---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';

// お悩みリスト（リアルな現場Before写真つき）
const troubles = [
  {
    tag: '剪定・枝払い',
    title: '木が伸びすぎて手が届かない・危険',
    desc: '「2階の窓まで伸びた」「電線やお隣に届きそう」「台風で倒れないか心配」。ご自身では危険な高所作業も安全に剪定・伐採します。',
    img: '/images/niwanosentei-01s02.jpg',
    alt: '伸び放題になった庭木のBefore写真'
  },
  {
    tag: '雑草・草むしり',
    title: '草がもじゃもじゃで追いつかない',
    desc: '毎年の草むしりで腰が痛い、夏場はすぐに草ぼうぼう…。草刈りから高耐久防草シート・砂利敷きまで、もう悩まないお庭へ整えます。',
    img: '/images/zouen1s02.jpg',
    alt: '雑草が生い茂った庭のBefore写真'
  },
  {
    tag: '枝の越境・荒れた庭',
    title: '庭木がボサボサ・隣家に越境している',
    desc: 'ご近所迷惑になる前に何とかしたい。手入れが追いつかず荒れてしまったお庭も、プロの手でスッキリ清潔に整えます。',
    img: '/images/zouen5s02.jpg',
    alt: '手入れが行き届かず荒れたお庭のBefore写真'
  },
  {
    tag: 'フェンス・竹垣',
    title: '古い垣根が傷んでボロボロになっている',
    desc: '天然竹が朽ちて倒れそう、目隠しが機能していない…。高耐久な人工竹垣へのリフォームや、おしゃれな和モダンフェンスに再生します。',
    img: '/images/takegakirifomu-01s02.jpg',
    alt: '古くなって傷んだ竹垣のBefore写真'
  }
];

// 選ばれる理由
const reasons = [
  {
    num: '01',
    title: '低木1本700円〜の明朗会計',
    lead: 'お見積もり後の不当な追加料金は一切ありません',
    desc: '「植木屋さんは高そう」「いくらかかるか不安」というお客様のために、明確な料金基準を設定。事前にお見積もりを提示し、ご納得いただいてから着工いたします。'
  },
  {
    num: '02',
    title: '職人直営！中間マージンゼロ',
    lead: '下請けを通さないから適正価格＆高品質な施工',
    desc: '大手ハウスメーカーや仲介業者を介さない職人直営店です。中間手数料がかからないため、適正価格で経験豊富な職人が責任を持って丁寧にお手入れいたします。'
  },
  {
    num: '03',
    title: '地元・粕屋密着の丁寧な作業＆近隣配慮',
    lead: '作業後の徹底した掃除・ゴミ処分まで手を抜きません',
    desc: '福岡・粕屋エリア密着だからスピーディに対応。作業中の安全配慮はもちろん、ご近所様へのご挨拶、切った枝葉の片付け・清掃まで誠意を込めて行います。'
  }
];

// サービス一覧と料金目安
const services = [
  {
    title: '庭木の剪定・伐採',
    price: '低木1本 ¥700〜 / 中木 ¥2,500〜',
    desc: '自然の樹形を生かした美しい剪定。日当たりや風通しを改善し、木を健康に保ちます。危険な大木の伐採も対応。',
    img: '/images/niwanosentei-02s02.jpg',
    features: ['低木1m未満：¥700', '中木2〜3m：¥2,500', '伐採：¥1,000〜', 'ゴミ処理対応']
  },
  {
    title: '防草シート・砂利敷き',
    price: '草刈り ¥200/㎡〜 / 防草シート ¥800/㎡〜',
    desc: '面倒な草むしりから解放！高耐久な防草シートと美しい砂利で、雑草を防ぎながら防犯性と美観を高めます。',
    img: '/images/zouen2s02.jpg',
    features: ['高耐久シート使用', '厳選砂利から選択', '整地・転圧込み', '部分施工もOK']
  },
  {
    title: '造園・坪庭・アプローチ',
    price: 'ご予算に合わせて無料プランニング',
    desc: '自然石や植栽を活かした和モダンな庭づくり。店舗や住宅のデッドスペースをおしゃれな癒やしの空間へ。',
    img: '/images/approach_02.jpg',
    features: ['和風・洋風対応', 'アプローチ通路', '照明・石組み', 'メンテナンス提案']
  },
  {
    title: '竹垣の施工・補修',
    price: '現地無料調査にてお見積もり',
    desc: '格式高い天然竹の垣根から、高耐久で色褪せない人工竹垣まで。目隠しや庭のアクセントに職人技で施工。',
    img: '/images/takegaki_sekou.jpg',
    features: ['建仁寺垣・御簾垣', '傷んだ竹垣の改修', '人工竹で長持ち', '目隠し・境界フェンス']
  }
];

// 流れ
const steps = [
  {
    num: 'STEP 01',
    title: 'お問い合わせ・無料相談',
    desc: '公式LINE・お電話・WEBフォームよりお気軽にご連絡ください。「木を1本だけ切りたい」でも大歓迎です。'
  },
  {
    num: 'STEP 02',
    title: '現地調査・無料お見積もり',
    desc: 'お庭を拝見し、ご希望やご予算を丁寧にヒアリング。明確なお見積もりを提示します（お断りいただいても費用は一切不要）。'
  },
  {
    num: 'STEP 03',
    title: 'ご契約・施工開始',
    desc: '日程を調整の上、経験豊富な職人が丁寧・安全に施工。屋外作業のため、当日のご不在でも施工可能です。'
  },
  {
    num: 'STEP 04',
    title: 'ご確認・お支払い',
    desc: '作業後の清掃まで徹底して行い、仕上がりをお客様にご確認いただいた後にお支払いとなります。'
  }
];

// FAQ
const faqs = [
  {
    q: '庭木1本だけの剪定でも頼めますか？',
    a: 'はい、もちろん大歓迎です！「低木1本（¥700〜）」から喜んでお伺いします。小さな作業でも気兼ねなくお声がけください。'
  },
  {
    q: '見積もりの後で断っても費用はかかりませんか？',
    a: '完全無料です。現地調査やお見積もり後にご検討いただき、お断りいただいても出張料などの費用は一切かかりません。しつこい営業も行いませんのでご安心ください。'
  },
  {
    q: '作業中は留守にしていても大丈夫ですか？',
    a: 'はい、屋外の作業ですのでご不在でも施工可能です。事前に作業内容を確認させていただき、完了後に作業箇所の写真等でご報告することも可能です。'
  },
  {
    q: '切った枝や抜いた草の処分もお願いできますか？',
    a: 'はい、剪定枝や刈り取った雑草の回収・処分まで承ります（軽トラック1台 ¥6,000）。掃除まで丁寧に行い、お庭をすっきり清潔な状態にしてお引き渡しいたします。'
  },
  {
    q: '対応エリアはどこまでですか？',
    a: '福岡県糟屋郡（粕屋町、篠栗町、志免町、須恵町、新宮町、久山町、宇美町）を中心に、福岡市、古賀市、大野城市、春日市など福岡都市圏全域に対応しております。近郊エリアの方もお気軽にご相談ください。'
  }
];
---

<BaseLayout
  title="福岡・粕屋の造園・庭木剪定なら「庭や・笑」（にわやしょう）"
  description="福岡県粕屋の造園・庭木剪定「庭や・笑」。低木1本700円〜の明朗会計。職人直営で中間マージンなし。お庭の剪定、草刈り、防草シート、竹垣などお庭のお悩みを丁寧に解決します。現地調査・見積無料。"
  currentPage="home"
>
  <!-- ① ファーストビュー（HeroSlider 100dvh） -->
  <HeroSlider />

  <!-- ② お悩み共感セクション（リアルBefore写真付きカード） -->
  <section class="section section-trouble" id="trouble">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">TROUBLES</span>
        <h2 class="section-headline">こんなお庭のお悩み、ありませんか？</h2>
        <p class="section-subheadline">
          「どこに頼めばいいか分からない」「少しの作業でも来てくれる？」<br class="pc-only" />
          庭や・笑なら、些細なことでも親身にお伺いいたします。
        </p>
      </div>

      <div class="trouble-photo-grid u-grid">
        {troubles.map((t, idx) => (
          <div class={`trouble-photo-card u-card fade-up delay-${(idx + 1) * 100}`}>
            <div class="trouble-photo-wrap">
              <span class="trouble-tag">{t.tag}</span>
              <span class="trouble-badge-before">Before 現場例</span>
              <img src={t.img} alt={t.alt} class="trouble-photo" loading="lazy" />
            </div>
            <div class="trouble-photo-body">
              <h3 class="trouble-photo-title">{t.title}</h3>
              <p class="trouble-photo-desc">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="trouble-solution-box fade-up">
        <p class="solution-lead">
          お庭の草木は、放っておくとどんどん手入れが大変になります。<br class="pc-only" />
          <strong>「庭や・笑」なら、一本の剪定・草刈りだけでも喜んで駆けつけます！</strong>
        </p>
        <a href="#contact" class="u-btn">まずはお気軽に無料相談する</a>
      </div>
    </div>
  </section>

  <!-- ③ 庭や・笑が選ばれる3つの安心 -->
  <section class="section section-reasons u-section--alt" id="reason">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">WHY CHOOSE US</span>
        <h2 class="section-headline">庭や・笑が選ばれる3つの安心</h2>
        <p class="section-subheadline">大手にはない小回りの良さと、職人直営ならではの誠実な対応をお約束します。</p>
      </div>

      <div class="reasons-list">
        {reasons.map((r) => (
          <div class="reason-row u-card fade-up">
            <div class="reason-num-col">
              <span class="reason-number">{r.num}</span>
              <span class="reason-label">REASON</span>
            </div>
            <div class="reason-content-col">
              <h3 class="reason-title">{r.title}</h3>
              <p class="reason-lead">{r.lead}</p>
              <p class="reason-desc">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ④ サービス案内＆料金表 -->
  <section class="section section-services" id="service">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">SERVICES & PRICES</span>
        <h2 class="section-headline">サービス案内と料金の目安</h2>
        <p class="section-subheadline">事前の明朗お見積もりを徹底。追加料金の心配なく安心してご依頼いただけます。</p>
      </div>

      <div class="services-grid u-grid">
        {services.map((s, idx) => (
          <div class={`service-box u-card fade-up delay-${(idx + 1) * 100}`}>
            <div class="service-img-wrap">
              <img src={s.img} alt={s.title} class="service-img" loading="lazy" />
              <div class="service-price-tag">{s.price}</div>
            </div>
            <div class="service-content">
              <h3 class="service-box-title">{s.title}</h3>
              <p class="service-box-desc">{s.desc}</p>
              <ul class="service-feature-list">
                {s.features.map(f => (
                  <li><span class="check-mark">&#10003;</span> {f}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- 詳しい料金表リンク案内 -->
      <div class="price-banner u-card fade-up">
        <div class="price-banner-text">
          <h3>詳細な料金一覧もご用意しております</h3>
          <p>木の高さや作業内容ごとの細かな価格表はこちらからご覧いただけます。</p>
        </div>
        <a href="/prices" class="u-btn u-btn--outline">詳細な料金表を見る</a>
      </div>
    </div>
  </section>

  <!-- ⑤ 施工実績Before/Afterスライダー -->
  <section class="section section-works u-section--alt" id="works">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">PORTFOLIO</span>
        <h2 class="section-headline">施工実績</h2>
        <p class="section-subheadline">これまでに手掛けたお庭・剪定のビフォーアフターをご覧ください。</p>
      </div>

      <div class="fade-up">
        <CaseStudySlider />
      </div>

      <div class="works-action-wrap fade-up">
        <a href="/case-study" class="u-btn u-btn--outline">すべての施工例を見る（全9件）</a>
      </div>
    </div>
  </section>

  <!-- ⑥ ご依頼の流れ -->
  <section class="section section-flow" id="flow">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">FLOW</span>
        <h2 class="section-headline">ご相談から完了までの流れ</h2>
        <p class="section-subheadline">簡単4ステップ。無理な営業は一切ございませんのでご安心ください。</p>
      </div>

      <div class="steps-timeline">
        {steps.map((st, idx) => (
          <div class={`step-card u-card fade-up delay-${(idx + 1) * 100}`}>
            <div class="step-num">{st.num}</div>
            <h3 class="step-title">{st.title}</h3>
            <p class="step-desc">{st.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ 代表メッセージ・想い -->
  <section class="section section-about u-section--alt" id="about">
    <div class="u-container">
      <div class="about-hero-box u-card fade-up">
        <div class="about-hero-header">
          <span class="section-badge">ABOUT US</span>
          <h2 class="about-hero-title">「笑顔が活きる空間に」</h2>
        </div>
        <p class="about-lead-text">
          私たちにとって庭とは、暮らしのそばで四季を映し、人の心を穏やかに整えてくれる場所です。<br />
          眺め、佇み、語らい、季節を味わう。<br />
          その場に居るだけで心が安らげる屋外空間すべてが庭だと思っています。<br />
          和・洋にとらわれず、お客様の生活スタイルに合わせたお庭づくりを心を込めてお手伝いいたします。
        </p>

        <!-- スタッフ紹介（上品なコンパクト表示） -->
        <div class="staff-compact-grid">
          <div class="staff-compact-card">
            <div class="staff-compact-avatar">
              <img src="/images/kasuya_zouen_fukuoka_001.5-300x300.jpg" alt="代表 権藤 伸一郎" />
            </div>
            <div class="staff-compact-info">
              <span class="staff-role">代表</span>
              <h4 class="staff-name-title">権藤 伸一郎</h4>
              <p class="staff-short-bio">
                樹形を生かした自然風な剪定が得意です。花や実、紅葉などの季節を感じて庭を楽しんでいただけるよう心を込めて作業します。
              </p>
            </div>
          </div>

          <div class="staff-compact-card">
            <div class="staff-compact-avatar">
              <img src="/images/kasuya_zouen_fukuoka_002.5-300x300.jpg" alt="職人 権藤 辰仁" />
            </div>
            <div class="staff-compact-info">
              <span class="staff-role">職人</span>
              <h4 class="staff-name-title">権藤 辰仁</h4>
              <p class="staff-short-bio">
                自然石を使った庭づくりが好きです。石や植物の中にちょっとした遊び心を入れ、お客様が笑顔になれるお庭を造ります。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑧ よくあるご質問（FAQ：アコーディオン折りたたみ開閉） -->
  <section class="section section-faq" id="faq">
    <div class="u-container">
      <div class="section-badge-wrap fade-up">
        <span class="section-badge">FAQ</span>
        <h2 class="section-headline">よくあるご質問</h2>
        <p class="section-subheadline">気になる質問をタップすると回答が開きます。</p>
      </div>

      <div class="faq-list">
        {faqs.map((f, idx) => (
          <details class={`faq-item u-card fade-up delay-${(idx + 1) * 100}`}>
            <summary class="faq-summary">
              <span class="faq-q-badge">Q</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-toggle-icon"></span>
            </summary>
            <div class="faq-answer">
              <span class="faq-a-badge">A</span>
              <p class="faq-a-text">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑨ 最強のお問い合わせセクション（LINE・電話・直接フォームの3大導線） -->
  <section class="section section-contact" id="contact">
    <div class="u-container">
      <div class="contact-main-card u-card fade-up">
        <span class="section-badge">CONTACT</span>
        <h2 class="contact-main-title">お庭のこと、まずはお気軽にご相談ください</h2>
        <p class="contact-main-lead">
          「1本だけ切ってほしい」「概算金額を知りたい」など大歓迎です。<br />
          現地調査・お見積もりは完全無料。無理な営業は一切いたしません。
        </p>

        <!-- 3つの問い合わせ方法（手軽さ順：LINE → 電話 → フォーム） -->
        <div class="contact-channels-grid">
          <!-- ① 公式LINE（写真送信で最短・最も手軽） -->
          <div class="channel-card channel-card--line">
            <div class="channel-badge">一番かんたん・写真で概算見積もり</div>
            <div class="channel-icon-wrap">
              <svg class="line-svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 5.91 2 10.74c0 2.94 1.66 5.54 4.23 7.15-.18.66-.66 2.39-.76 2.76-.12.45.16.44.34.33.24-.15 3.32-2.26 4.67-3.18.5.07 1.01.1 1.52.1 5.52 0 10-3.91 10-8.74C22 5.91 17.52 2 12 2z"/>
              </svg>
            </div>
            <h3 class="channel-title">LINEで写真見積もり</h3>
            <p class="channel-desc">気になるお庭の写真をスマホで撮って送るだけ！最短30分で概算お見積もりをお返しします。</p>
            <a href="https://line.me" target="_blank" rel="noopener noreferrer" class="line-action-btn">
              <span>公式LINEで相談する</span>
              <span class="line-btn-sub">（友だち追加・無料）</span>
            </a>
          </div>

          <!-- ② お電話（お急ぎ・直接話したい方） -->
          <div class="channel-card channel-card--tel">
            <div class="channel-badge channel-badge--tel">お急ぎの方に</div>
            <div class="channel-icon-wrap channel-icon-wrap--tel">
              📞
            </div>
            <h3 class="channel-title">お電話で無料相談</h3>
            <p class="channel-desc">作業内容や日程のご相談など、直接職人が丁寧にお伺いします。通話料無料。</p>
            <a href="tel:0925150747" class="tel-action-btn">
              <span class="tel-num-main">092-515-0747</span>
              <span class="tel-time-note">平日 9:00〜18:00 受付</span>
            </a>
          </div>
        </div>

        <!-- ③ ページ内直接お問い合わせフォーム -->
        <div class="inline-form-box" id="inline-form">
          <div class="inline-form-header">
            <h3>WEBからのお問い合わせ（24時間受付）</h3>
            <p>下記項目をご入力の上、送信ボタンを押してください。翌営業日までに丁寧にご返信いたします。</p>
          </div>

          <form
