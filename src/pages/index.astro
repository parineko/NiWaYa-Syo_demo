---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
---

<BaseLayout title="福岡 粕屋の造園 庭の事なら「庭や・笑」（にわやしょう）" currentPage="home">
    <!-- ヒーロースライダー -->
    <HeroSlider client:load />

    <!-- モットーセクション（1文のみ） -->
    <section class="motto-section u-section" style="padding: 10px 0 100px 0; background: #ffffff;">
        <div class="container u-container">
            <div style="text-align: center;">
                <h2 style="font-size: 32px; font-weight: 600; font-family: 'Noto Serif JP', serif; color: #000000; margin: 0;">
                    「笑顔が活きる空間に」をモットーに、和・洋にとらわれずお客様の生活スタイルに合わせた庭をご提案いたします。
                </h2>
            </div>
        </div>
    </section>

    <FloatingContactButton />
</BaseLayout>

