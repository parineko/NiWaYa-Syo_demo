---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import '../styles/_variables.css';
import '../styles/_reset.css';
import '../styles/_layout.css';
import '../styles/_utilities.css';
import '../styles/_components.css';
import '../styles/_pages.css';
import '../styles/extra.css';
import 'swiper/css';
import 'swiper/css/pagination';
import 'swiper/css/effect-fade';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = "福岡・粕屋の造園・庭木剪定・エクステリアなら「庭や・笑（にわやしょう）」。笑顔が活きる空間に。1本からの庭木剪定、造園、竹垣、防草シートなど丁寧に対応いたします。",
  currentPage
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="庭や・笑（にわやしょう）">
    <meta name="twitter:card" content="summary_large_image">
    
    <!-- フォント読み込みの最適化（ウェイトを絞って高速化・チラつき防止） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600&family=Shippori+Mincho:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- オープニングローディング画面 -->
    <LoadingScreen />

    <Header currentPage={currentPage} />
    
    <main id="content" class="site-content">
        <slot />
    </main>
    
    <Footer />
    
    <script>
        import initLayout from '../scripts/layout';
        initLayout();
    </script>
</body>
</html>
